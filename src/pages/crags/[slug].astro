---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const crags = await getCollection('crags');
  return crags.map(crag => ({
    params: { slug: crag.slug },
    props: { crag },
  }));
}

const { crag } = Astro.props;
const { Content } = await crag.render();

const routes = crag.data.routes;
const sectorNames: string[] = routes.length
  ? [...new Set(routes.map(r => r.sector ?? '전체'))].sort()
  : [];
type CragRoute = typeof routes[number];
const routesBySector: Record<string, CragRoute[]> = {};
for (const r of routes) {
  const s = r.sector ?? '전체';
  if (!routesBySector[s]) routesBySector[s] = [];
  routesBySector[s].push(r);
}

const allLogs = await getCollection('logs');
const relatedLogs = allLogs
  .filter(l => l.data.crag === crag.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={crag.data.title} description={crag.data.summary}>
<article>
<div class="container">

  <div class="doc-meta">
    <a href="/crags/">← Crags</a>
    {crag.data.updated && (
      <>
        <span class="dot">·</span>
        <span>Updated {crag.data.updated.toISOString().slice(0,10)}</span>
      </>
    )}
  </div>

  <h1>{crag.data.title}</h1>
  {crag.data.summary && <p class="summary">{crag.data.summary}</p>}

  {crag.data.location && (
    <div class="data-box">
      <div class="data-row">
        <span class="data-label">위치</span>
        <span>{crag.data.location.region}{crag.data.location.city && ` — ${crag.data.location.city}`}</span>
      </div>
      <div class="data-row">
        <span class="data-label">좌표</span>
        <span class="mono">{crag.data.location.lat}°, {crag.data.location.lng}°</span>
      </div>
      {crag.data.rock_type && (
        <div class="data-row">
          <span class="data-label">암질</span>
          <span>{crag.data.rock_type}</span>
        </div>
      )}
      {crag.data.disciplines.length > 0 && (
        <div class="data-row">
          <span class="data-label">종류</span>
          <span>{crag.data.disciplines.join(' · ')}</span>
        </div>
      )}
      {crag.data.approach_minutes && (
        <div class="data-row">
          <span class="data-label">접근</span>
          <span>{crag.data.approach_minutes}분</span>
        </div>
      )}
      {crag.data.season_best.length > 0 && (
        <div class="data-row">
          <span class="data-label">시즌</span>
          <span>{crag.data.season_best.join(' · ')}</span>
        </div>
      )}
      {routes.length > 0 && (
        <div class="data-row">
          <span class="data-label">루트 수</span>
          <span>{routes.length}개</span>
        </div>
      )}
    </div>
  )}

  {crag.data.tags.length > 0 && (
    <div class="tags">
      {crag.data.tags.map(t => <span class="tag">{t}</span>)}
    </div>
  )}

  {routes.length > 0 && (
    <section class="routes-section">
      <div class="eyebrow" style="margin-top:3rem;">Routes — 루트 목록</div>
      {sectorNames.map(sector => (
        <div class="sector-block">
          {sectorNames.length > 1 && <div class="sector-label">{sector}</div>}
          <table class="route-table">
            <thead>
              <tr>
                <th class="col-num">#</th>
                <th>이름</th>
                <th class="col-grade">난이도</th>
                <th class="col-len">길이</th>
                <th class="col-style">스타일</th>
              </tr>
            </thead>
            <tbody>
              {routesBySector[sector].map(r => (
                <tr>
                  <td class="col-num mono">{r.number ?? '—'}</td>
                  <td>
                    <span class="route-name">{r.name ?? '(미상)'}</span>
                    {r.notes && <span class="route-note">{r.notes}</span>}
                    {r.pitches.length > 0 && (
                      <div class="pitch-inline">
                        {r.pitches.map(p => (
                          <span class="pitch-pip">P{p.number}{p.grade ? ` ${p.grade}` : ''}</span>
                        ))}
                      </div>
                    )}
                  </td>
                  <td class="col-grade mono">{r.grade ?? '—'}</td>
                  <td class="col-len mono">
                    {r.length_m ? `${r.length_m}m` : r.pitches_count ? `${r.pitches_count}P` : '—'}
                  </td>
                  <td class="col-style">{r.style && <span class="style-chip">{r.style}</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>
  )}

  <hr class="rule" style="margin-top: 3rem;" />
  <div class="prose"><Content /></div>

  {relatedLogs.length > 0 && (
    <section class="related">
      <hr class="rule-ornate" />
      <div class="eyebrow">이 암장과 함께한 날들</div>
      <ul class="related-list">
        {relatedLogs.map(log => (
          <li>
            <a href={`/logs/${log.slug}/`}>
              <span class="related-date mono">{log.data.date.toISOString().slice(0,10)}</span>
              <span class="related-title">{log.data.title}</span>
              {log.data.weather && <span class="related-weather mono">{log.data.weather}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

</div>
</article>

<style>
  .doc-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.6em;
    align-items: center;
  }
  .doc-meta a { border: none; color: var(--stone-700); }
  .doc-meta a:hover { color: var(--ochre); }
  .doc-meta .dot { opacity: 0.5; }

  h1 { font-family: 'Fraunces', serif; margin-bottom: 1rem; }
  .summary {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--stone-900);
    margin: 1rem 0 2rem;
  }
  .mono { font-family: 'JetBrains Mono', monospace; }

  .data-box {
    background: var(--paper-soft);
    border: 1px solid var(--rule);
    padding: 1.2rem 1.5rem;
    margin: 2rem 0;
    font-size: 0.9rem;
  }
  .data-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    gap: 1rem;
  }
  .data-row:last-child { border-bottom: none; }
  .data-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone-500);
    padding-top: 2px;
  }

  .routes-section { margin-bottom: 0; }
  .sector-block { margin-bottom: 2rem; }
  .sector-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule);
  }
  .route-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .route-table th {
    text-align: left;
    padding: 0.7rem 0.5rem;
    border-bottom: 2px solid var(--ink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-500);
    font-weight: 500;
  }
  .route-table td { padding: 0.85rem 0.5rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .route-table tr:last-child td { border-bottom: none; }
  .route-table tr:hover td { background: color-mix(in srgb, var(--ochre) 3%, transparent); }
  .col-num  { width: 36px; color: var(--stone-500); }
  .col-grade { width: 80px; }
  .col-len  { width: 70px; color: var(--stone-700); }
  .col-style { width: 80px; }
  .route-name { font-family: 'Hahmlet', serif; font-size: 1rem; display: block; }
  .route-note { display: block; font-size: 0.78rem; color: var(--stone-700); margin-top: 0.15rem; }
  .pitch-inline { display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .pitch-pip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    padding: 0.15em 0.5em;
    background: var(--stone-100);
    color: var(--stone-700);
    border: 1px solid var(--rule);
  }
  .style-chip { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; color: var(--stone-500); }

  .related { margin-top: 4rem; }
  .related-list { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .related-list li { border-bottom: 1px solid var(--rule); }
  .related-list li:first-child { border-top: 1px solid var(--rule); }
  .related-list a {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 1rem;
    padding: 1rem 0;
    border: none;
    color: var(--ink);
    align-items: baseline;
    transition: background 0.15s;
  }
  .related-list a:hover { background: color-mix(in srgb, var(--ochre) 5%, transparent); color: var(--ink); }
  .related-date { font-size: 0.8rem; color: var(--stone-500); }
  .related-title { font-family: 'Fraunces', serif; font-size: 1.1rem; }
  .related-weather { font-size: 0.75rem; color: var(--stone-500); }

  @media (max-width: 640px) {
    .data-row { grid-template-columns: 1fr; gap: 0.2rem; padding: 0.6rem 0; }
    .col-len, .col-style { display: none; }
    .related-list a { grid-template-columns: 1fr; gap: 0.3rem; padding: 0.8rem 0; }
  }
</style>
</BaseLayout>
