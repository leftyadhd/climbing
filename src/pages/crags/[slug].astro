---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const crags = await getCollection('crags');
  return crags.map(crag => ({
    params: { slug: crag.slug ?? crag.id.replace(/\.md$/, '').split('/').pop()! },
    props: { crag },
  }));
}

const { crag } = Astro.props;
const { Content } = await crag.render();

const routes = crag.data.routes;
type CragRoute = typeof routes[number];

// Sector ordering: sectors[] is now {id, name}[] — match by id
const topSectors = crag.data.sectors ?? [];  // {id, name}[]
const topSectorIds = topSectors.map(s => s.id);
const routeSectorIds = [...new Set(routes.map(r => r.sector).filter((s): s is string => !!s))];
const hasSectorDef = topSectors.length > 0;
// Ordered list of sector ids: defined first, then any extras found in routes
const orderedSectorIds: string[] = hasSectorDef
  ? [...topSectorIds, ...routeSectorIds.filter(s => !topSectorIds.includes(s))]
  : routeSectorIds.sort();
const UNSECTORED = hasSectorDef ? '기타' : '전체';
const byS: Record<string, CragRoute[]> = {};
for (const r of routes) {
  const s = r.sector ?? UNSECTORED;
  if (!byS[s]) byS[s] = [];
  byS[s].push(r);
}
if (byS[UNSECTORED]) orderedSectorIds.push(UNSECTORED);
const sectorIds = orderedSectorIds.length > 0 ? orderedSectorIds : routes.length ? ['전체'] : [];
if (!byS['전체'] && sectorIds.includes('전체') && !hasSectorDef) byS['전체'] = routes;
// Helper: id → display name
const sectorLabel = (id: string) => topSectors.find(s => s.id === id)?.name ?? id;

const allLogs = await getCollection('logs');
const myKey = (crag.slug ?? crag.id.replace(/\.md$/,'').split('/').pop()!).normalize('NFC');
const relatedLogs = allLogs
  .filter(l => l.data.crag && l.data.crag.normalize('NFC') === myKey)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// route_ref 역방향 맵: route id → 해당 루트를 기록한 로그들
const routeLogMap = new Map<string, typeof relatedLogs>();
for (const log of relatedLogs) {
  for (const lr of log.data.routes) {
    if (lr.route_ref) {
      if (!routeLogMap.has(lr.route_ref)) routeLogMap.set(lr.route_ref, []);
      routeLogMap.get(lr.route_ref)!.push(log);
    }
  }
}

function gradeColor(g: string | null | undefined): string {
  if (!g) return 'transparent';
  if (/5\.[67]/.test(g)) return '#2a7a38';
  if (/5\.[89]/.test(g)) return '#1e6830';
  if (/5\.10[ab]/i.test(g)) return '#6a8818';
  if (/5\.10[cd]/i.test(g)) return '#a07010';
  if (/5\.11/i.test(g)) return '#b83408';
  if (/5\.1[234]/i.test(g)) return '#8a0808';
  return 'transparent';
}
const gColor = (g: string|null|undefined) => gradeColor(g);
const gText  = (g: string|null|undefined) => gradeColor(g) === 'transparent' ? 'var(--stone-700)' : '#fff';
---
<BaseLayout title={crag.data.title} description={crag.data.summary}>
<article class="crag-detail">

  <!-- ══════════════════════════ BREADCRUMB ══ -->
  <nav class="bc">
    <div class="bc-inner">
      <a href="/crags/">← Crags</a>
      {crag.data.mountain && <><span class="bc-sep">·</span><span>{crag.data.mountain}</span></>}
    </div>
  </nav>

  <!-- ═══════════════════════════ CRAG HEAD ══ -->
  <header class="crag-hd">
    <div class="crag-hd-inner">
      <h1>{crag.data.title}</h1>
      {crag.data.summary && <p class="summary">{crag.data.summary}</p>}

      {crag.data.location && (
        <div class="info-strip">
          <div class="iitem">
            <span class="ilabel">위치</span>
            <span class="ival">{crag.data.location.region}{crag.data.location.city && ` · ${crag.data.location.city}`}</span>
          </div>
          {crag.data.rock_type && (
            <div class="iitem">
              <span class="ilabel">암질</span>
              <span class="ival">{crag.data.rock_type}</span>
            </div>
          )}
          {crag.data.disciplines.length > 0 && (
            <div class="iitem">
              <span class="ilabel">종류</span>
              <span class="ival">{crag.data.disciplines.join(' · ')}</span>
            </div>
          )}
          {crag.data.approach_minutes && (
            <div class="iitem">
              <span class="ilabel">접근</span>
              <span class="ival mono">{crag.data.approach_minutes}분</span>
            </div>
          )}
          {crag.data.season_best.length > 0 && (
            <div class="iitem">
              <span class="ilabel">시즌</span>
              <span class="ival">{crag.data.season_best.join(' · ')}</span>
            </div>
          )}
          {routes.length > 0 && (
            <div class="iitem">
              <span class="ilabel">루트</span>
              <span class="ival mono">{routes.length}개</span>
            </div>
          )}
          {relatedLogs.length > 0 && (
            <div class="iitem">
              <span class="ilabel">방문</span>
              <span class="ival mono">{relatedLogs.length}회</span>
            </div>
          )}
          {crag.data.location.lat && crag.data.location.lng && (
            <div class="iitem">
              <a
                class="imap"
                href={`https://maps.google.com/?q=${crag.data.location.lat},${crag.data.location.lng}`}
                target="_blank" rel="noopener"
              >지도 ↗</a>
            </div>
          )}
        </div>
      )}
      {crag.data.tags.length > 0 && (
        <div class="tags">{crag.data.tags.map(t => <span class="tag">{t}</span>)}</div>
      )}
    </div>
  </header>

  <!-- ════════════════════════ ROUTES ══ -->
  {routes.length > 0 && !crag.data.crag_type.includes('gym') && (
    <section class="routes-sec">
      <div class="routes-inner">
        <div class="sec-eyebrow">Routes — 루트 목록</div>

        {crag.data.crag_type.includes('multi-pitch') ? (
          // ── 멀티피치: 루트 카드 레이아웃 ──
          <div class="mp-list">
            {routes.map(r => {
              const refLogs = routeLogMap.get(r.id) ?? [];
              const pitchCount = r.pitches.length > 0 ? r.pitches.length : (r.pitches_count ?? 0);
              return (
                <div class="mp-card">
                  <div class="mp-card-hd">
                    <div class="mp-title-row">
                      <span class="mp-rname">{r.name ?? r.id}</span>
                      <div class="mp-badges">
                        {r.grade && <span class="gbadge" style={`background:${gColor(r.grade)};color:${gText(r.grade)}`}>{r.grade}</span>}
                        {pitchCount > 0 && <span class="mp-pitchcount mono">{pitchCount}P</span>}
                        {r.style && <span class="style-chip mono">{r.style}</span>}
                      </div>
                    </div>
                    {r.notes && <p class="mp-notes">{r.notes}</p>}
                    {refLogs.length > 0 && (
                      <div class="rroute-logs">
                        {refLogs.map(l => {
                          const d = l.data.date;
                          const ds = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
                          return <a href={`/logs/${l.slug}/`} class="rroute-log-link mono">{ds}</a>;
                        })}
                      </div>
                    )}
                  </div>
                  {r.pitches.length > 0 && (
                    <table class="pitch-tbl">
                      <thead>
                        <tr>
                          <th class="pt-num">피치</th>
                          <th>타입</th>
                          <th class="pt-grade">난이도</th>
                          <th class="pt-len">길이</th>
                        </tr>
                      </thead>
                      <tbody>
                        {r.pitches.map(p => (
                          <tr>
                            <td class="pt-num mono">P{p.number}</td>
                            <td class="pt-type">{p.type ?? '—'}</td>
                            <td class="pt-grade">
                              {p.grade
                                ? <span class="gbadge" style={`background:${gColor(p.grade)};color:${gText(p.grade)}`}>{p.grade}</span>
                                : <span class="gdash mono">—</span>
                              }
                            </td>
                            <td class="pt-len mono">{p.length ?? (p.length_m ? `${p.length_m}m` : '—')}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                </div>
              );
            })}
          </div>
        ) : (
          // ── 스포트/기본: 테이블 레이아웃 ──
          (() => {
            const visibleSectors = sectorIds.filter(s => (byS[s]?.length ?? 0) > 0);
            const multiSector = visibleSectors.length > 1;
            return visibleSectors.map(sectorId => (
              <div class="sector-blk">
                {multiSector && <div class="sector-label">{sectorLabel(sectorId)}</div>}
                <table class="rtable">
                  <thead>
                    <tr>
                      <th class="th-num">#</th>
                      <th>이름</th>
                      <th class="th-grade">난이도</th>
                      <th class="th-len">길이</th>
                      <th class="th-style">스타일</th>
                    </tr>
                  </thead>
                  <tbody>
                    {byS[sectorId].map(r => {
                      const isMultiPitch = r.pitches.length > 0;
                      const refLogs = routeLogMap.get(r.id) ?? [];
                      return isMultiPitch ? (
                        <>
                          <tr class="tr-multi-hd">
                            <td class="td-num mono">{r.number ?? '—'}</td>
                            <td>
                              <span class="rname">{r.name ?? '(미상)'}</span>
                              {r.notes && <span class="rnote">{r.notes}</span>}
                              {refLogs.length > 0 && (
                                <div class="rroute-logs">
                                  {refLogs.map(l => {
                                    const d = l.data.date;
                                    const ds = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
                                    return <a href={`/logs/${l.slug}/`} class="rroute-log-link mono">{ds}</a>;
                                  })}
                                </div>
                              )}
                            </td>
                            <td class="th-grade">
                              {r.grade
                                ? <span class="gbadge" style={`background:${gColor(r.grade)};color:${gText(r.grade)}`}>{r.grade}</span>
                                : <span class="gdash mono">—</span>
                              }
                            </td>
                            <td class="th-len mono">{r.pitches_count ? `${r.pitches_count}P` : `${r.pitches.length}P`}</td>
                            <td class="th-style">{r.style && <span class="style-chip mono">{r.style}</span>}</td>
                          </tr>
                          {r.pitches.map(p => (
                            <tr class="tr-pitch">
                              <td></td>
                              <td class="td-pitch-row mono">
                                <span class="pitch-num">P{p.number}</span>
                                {p.type && <span class="pitch-type">{p.type}</span>}
                                {p.description && <span class="pitch-desc">{p.description}</span>}
                              </td>
                              <td class="th-grade">
                                {p.grade
                                  ? <span class="gbadge" style={`background:${gColor(p.grade)};color:${gText(p.grade)}`}>{p.grade}</span>
                                  : null
                                }
                              </td>
                              <td class="th-len mono">{p.length ?? (p.length_m ? `${p.length_m}m` : '—')}</td>
                              <td></td>
                            </tr>
                          ))}
                        </>
                      ) : (
                        <tr>
                          <td class="td-num mono">{r.number ?? '—'}</td>
                          <td>
                            <span class="rname">{r.name ?? '(미상)'}</span>
                            {r.notes && <span class="rnote">{r.notes}</span>}
                            {refLogs.length > 0 && (
                              <div class="rroute-logs">
                                {refLogs.map(l => {
                                  const d = l.data.date;
                                  const ds = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
                                  return <a href={`/logs/${l.slug}/`} class="rroute-log-link mono">{ds}</a>;
                                })}
                              </div>
                            )}
                          </td>
                          <td class="th-grade">
                            {r.grade
                              ? <span class="gbadge" style={`background:${gColor(r.grade)};color:${gText(r.grade)}`}>{r.grade}</span>
                              : <span class="gdash mono">—</span>
                            }
                          </td>
                          <td class="th-len mono">{r.length_m ? `${r.length_m}m` : r.pitches_count ? `${r.pitches_count}P` : '—'}</td>
                          <td class="th-style">{r.style && <span class="style-chip mono">{r.style}</span>}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            ));
          })()
        )}
      </div>
    </section>
  )}

  <!-- ══════════════════════════════ PROSE ══ -->
  <div class="prose-sec">
    <div class="prose-inner">
      <div class="prose"><Content /></div>
    </div>
  </div>

  <!-- ════════════════════ RELATED LOGS ══ -->
  {relatedLogs.length > 0 && (
    <section class="related-sec">
      <div class="related-inner">
        <hr class="ornate" />
        <div class="sec-eyebrow">이 암장과 함께한 날들</div>
        <div class="related-list">
          {relatedLogs.map(log => {
            const sv = log.data.routes.filter(r=>['onsight','flash','redpoint','send'].includes(r.status)).length;
            const d = log.data.date;
            return (
              <a href={`/logs/${log.slug}/`} class="rlog">
                <div class="rlog-date">
                  <span class="rlog-day mono">{String(d.getDate()).padStart(2,'0')}</span>
                  <span class="rlog-ym mono">{d.getFullYear()}.{String(d.getMonth()+1).padStart(2,'0')}</span>
                </div>
                <div class="rlog-body">
                  <div class="rlog-title">{log.data.title}</div>
                  <div class="rlog-meta">
                    {log.data.sector && <span class="rlog-sector">{log.data.sector}</span>}
                    {log.data.weather && <span>{log.data.weather}</span>}
                  </div>
                </div>
                {sv > 0 && (
                  <div class="rlog-result">
                    <span class="rsend">{sv}<small>SENT</small></span>
                  </div>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</article>

<style>
  .crag-detail { min-height: 100vh; padding-bottom: 6rem; }
  .mono { font-family: 'JetBrains Mono', monospace; }

  /* ── BREADCRUMB ── */
  .bc { border-bottom: 1px solid var(--rule); padding: 0.9rem 2rem; }
  .bc-inner {
    max-width: 920px; margin: 0 auto;
    display: flex; gap: 0.6em; align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--stone-500);
  }
  .bc-inner a { border: none; color: var(--stone-700); }
  .bc-inner a:hover { color: var(--ochre); }
  .bc-sep { opacity: 0.4; }

  /* ── CRAG HEAD ── */
  .crag-hd { padding: 3.5rem 2rem 2.5rem; border-bottom: 1px solid var(--rule); }
  .crag-hd-inner { max-width: 920px; margin: 0 auto; }
  h1 {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.08;
    margin-bottom: 0.7rem;
  }
  .summary {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--stone-700);
    margin: 0 0 2rem;
  }

  /* INFO STRIP */
  .info-strip {
    display: flex;
    flex-wrap: wrap;
    border: 1px solid var(--rule-strong);
    background: var(--paper-soft);
    margin-bottom: 1.5rem;
  }
  .iitem {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1.2rem;
    border-right: 1px solid var(--rule);
    min-width: 0;
  }
  .iitem:last-child { border-right: none; }
  .ilabel {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 0.3rem;
  }
  .ival { font-size: 0.88rem; color: var(--ink); font-weight: 500; }
  .imap {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--ochre);
    border: none;
    text-transform: uppercase;
    margin-top: auto;
    padding-top: 1.1rem;
  }
  .imap:hover { color: var(--ochre); opacity: 0.7; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tag { font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; padding: 0.2em 0.6em; background: var(--stone-100); color: var(--stone-700); border: 1px solid var(--rule); }

  /* SECTION EYEBROW */
  .sec-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--stone-500);
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-bottom: 1.5rem;
  }
  .sec-eyebrow::before { content: ''; display: inline-block; width: 16px; height: 1px; background: var(--ochre); }

  /* ── ROUTES ── */
  .routes-sec { padding: 3rem 2rem 0; border-top: 1px solid var(--rule); }
  .routes-inner { max-width: 920px; margin: 0 auto; }
  .sector-blk { margin-bottom: 2.5rem; }
  .sector-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--stone-500); margin-bottom: 0.6rem;
    padding-bottom: 0.4rem; border-bottom: 1px solid var(--rule);
  }
  .rtable { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .rtable th {
    text-align: left; padding: 0.7rem 0.6rem;
    border-bottom: 1px solid var(--ink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--stone-500); font-weight: 500;
  }
  .rtable td {
    padding: 0.9rem 0.6rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .rtable tr:last-child td { border-bottom: none; }
  .rtable tr:hover td { background: color-mix(in srgb, var(--ochre) 3%, transparent); }
  .th-num   { width: 32px; }
  .th-grade { width: 82px; }
  .th-len   { width: 62px; color: var(--stone-700); font-size: 0.82rem; }
  .th-style { width: 68px; }
  .td-num   { color: var(--stone-500); font-size: 0.78rem; }
  .rname { font-family: 'Spoqa Han Sans Neo', sans-serif; font-size: 0.98rem; display: block; letter-spacing: -0.01em; }
  .rnote { display: block; font-size: 0.76rem; color: var(--stone-700); margin-top: 0.12rem; }
  .ppips { display: flex; gap: 0.28rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .ppip { font-size: 0.58rem; padding: 0.12em 0.42em; background: var(--stone-100); color: var(--stone-700); border: 1px solid var(--rule); }
  .gbadge { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; padding: 0.2em 0.5em; border-radius: 2px; font-weight: 500; white-space: nowrap; }
  .gdash  { color: var(--stone-500); }
  .style-chip { font-size: 0.62rem; color: var(--stone-500); }
  /* Multi-pitch rows */
  .tr-multi-hd td { background: color-mix(in srgb, var(--ochre) 5%, var(--paper-card)); border-bottom: 1px solid var(--rule-strong); }
  .tr-pitch td { padding: 0.45rem 0.6rem; border-bottom: 1px solid var(--rule); background: var(--paper-soft); }
  .td-pitch-row { display: flex; align-items: center; gap: 0.5rem; }
  .pitch-num { font-size: 0.65rem; font-weight: 600; color: var(--ochre); min-width: 1.8rem; }
  .pitch-type { font-size: 0.68rem; color: var(--stone-700); background: var(--stone-100); border: 1px solid var(--rule); padding: 0.1em 0.4em; }
  .pitch-desc { font-size: 0.72rem; color: var(--stone-500); }
  .rroute-logs { display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.35rem; }
  .rroute-log-link {
    font-size: 0.58rem; padding: 0.12em 0.5em;
    background: color-mix(in srgb, var(--ochre) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--ochre) 25%, transparent);
    color: var(--ochre); border-radius: 2px;
    text-decoration: none; transition: opacity 0.1s;
  }
  .rroute-log-link:hover { opacity: 0.7; }
  .rlog-sector {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem; letter-spacing: 0.04em;
    color: var(--stone-500);
    background: var(--stone-100);
    border: 1px solid var(--rule);
    padding: 0.1em 0.45em; margin-right: 0.4rem;
  }

  /* ── MULTI-PITCH CARDS ── */
  .mp-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .mp-card {
    border: 1px solid var(--rule-strong);
    background: var(--paper-card);
  }
  .mp-card-hd {
    padding: 1.2rem 1.4rem 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .mp-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .mp-rname {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .mp-badges { display: flex; align-items: center; gap: 0.4rem; }
  .mp-pitchcount {
    font-size: 0.7rem;
    padding: 0.18em 0.6em;
    background: var(--stone-100);
    border: 1px solid var(--rule);
    color: var(--stone-700);
