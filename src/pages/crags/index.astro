---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const crags = await getCollection('crags');
crags.sort((a, b) => a.data.title.localeCompare(b.data.title, 'ko'));

const allLogs = await getCollection('logs');

const cragData = crags.map(crag => {
  const logCount = allLogs.filter(l => l.data.crag === crag.slug).length;
  return { crag, logCount };
});

// 산별 그루핑: mountain 있는 것은 묶고, 없는 것은 단독
const mountainMap = new Map<string, typeof cragData>();
const standalone: typeof cragData = [];
for (const item of cragData) {
  const m = item.crag.data.mountain;
  if (m) {
    if (!mountainMap.has(m)) mountainMap.set(m, []);
    mountainMap.get(m)!.push(item);
  } else {
    standalone.push(item);
  }
}
const groups: { label: string | null; items: typeof cragData }[] = [
  ...[...mountainMap.entries()].map(([label, items]) => ({ label, items })),
  ...standalone.map(item => ({ label: null, items: [item] })),
];
---
<BaseLayout title="암장">
<div class="container">

  <div class="eyebrow">Crags — 암장</div>
  <h1>내가 오른 <em>바위들.</em></h1>

  <div class="crag-groups">
    {groups.map(({ label, items }) => (
      <div class="crag-group">
        {label && <div class="mountain-label">{label}</div>}
        <ul class="crag-list">
          {items.map(({ crag, logCount }) => (
            <li>
              <a href={`/crags/${crag.slug}/`} class="crag-row">
                <div class="crag-left">
                  <span class="crag-title">{crag.data.title}</span>
                  {crag.data.summary && <span class="crag-summary">{crag.data.summary}</span>}
                </div>
                <div class="crag-right">
                  {crag.data.location && (
                    <span class="crag-region mono">{crag.data.location.region}</span>
                  )}
                  {crag.data.routes.length > 0 && (
                    <span class="crag-routes mono">{crag.data.routes.length}R</span>
                  )}
                  {logCount > 0 && (
                    <span class="crag-logs mono">{logCount}회</span>
                  )}
                  {crag.data.rock_type && (
                    <span class="crag-rock">{crag.data.rock_type}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

</div>

<style>
  h1 {
    font-family: 'Fraunces', 'Hahmlet', serif;
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 2.5rem;
  }
  h1 em { font-style: italic; color: var(--ochre); }

  .crag-groups { display: flex; flex-direction: column; gap: 2.5rem; }
  .crag-group {}
  .mountain-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 0.4rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .crag-list { list-style: none; margin: 0; padding: 0; }
  .crag-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    border-top: none;
    color: var(--ink);
    transition: background 0.15s, padding 0.15s;
  }
  .crag-list li:first-child .crag-row { border-top: 1px solid var(--rule); }
  .crag-row:hover { padding-left: 1rem; background: color-mix(in srgb, var(--ochre) 4%, transparent); color: var(--ink); }

  .crag-left { min-width: 0; }
  .crag-title {
    font-family: 'Hahmlet', 'Fraunces', serif;
    font-size: 1.15rem;
    font-weight: 400;
    display: block;
  }
  .crag-summary {
    display: block;
    font-size: 0.82rem;
    color: var(--stone-700);
    margin-top: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 400px;
  }

  .crag-right {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-shrink: 0;
  }
  .mono { font-family: 'JetBrains Mono', monospace; }
  .crag-region { font-size: 0.75rem; color: var(--stone-500); }
  .crag-routes { font-size: 0.75rem; color: var(--moss); }
  .crag-logs { font-size: 0.75rem; color: var(--stone-500); }
  .crag-rock { font-size: 0.75rem; color: var(--stone-500); }
</style>
</BaseLayout>
