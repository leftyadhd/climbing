            {/* X axis */}
            <line x1={padL} y1={padT + innerH} x2={padL + innerW} y2={padT + innerH} class="gc-axis" />
          </svg>
          <div class="grade-legend">
            <span class="gl-pr">● PR</span>
            <span class="gl-tr">● 기본(TR)</span>
            <span class="gl-lead">● 선등</span>
            {gradeTimeline.length > 0 && (
