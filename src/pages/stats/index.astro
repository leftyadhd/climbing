            {/* Route dots — 선등(lead) / 톱로핑(TR) 색상 구별 */}
            {routeDots.map(d => (
              <a href={`/logs/${d.logSlug}/`}>
                <circle
                  cx={xScale(d.date).toFixed(1)}
                  cy={yScale(d.gradeNum).toFixed(1)}
                  r={d.isPR ? 5 : 3.5}
                  class={d.isLead ? (d.isPR ? 'gc-dot gc-dot-lead-pr' : 'gc-dot gc-dot-lead') : (d.isPR ? 'gc-dot gc-dot-pr' : 'gc-dot gc-dot-tr')}
