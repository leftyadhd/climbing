---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allLogs = (await getCollection('logs')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf()
);
const climbLogs = allLogs.filter(l => l.data.type !== 'misc');

const allCrags = await getCollection('crags');
const cragTitleMap = new Map<string, string>();
for (const c of allCrags) {
  const key = c.id.replace(/\.md$/, '').split('/').pop()!.normalize('NFC');
  cragTitleMap.set(key, c.data.title);
}
const getCragTitle = (slug: string) =>
  cragTitleMap.get(slug.normalize('NFC')) ?? slug;

const allRoutes = climbLogs.flatMap(l => l.data.routes);
const sendSet = new Set(['onsight', 'flash', 'redpoint', 'send']);
const sends = allRoutes.filter(r => sendSet.has(r.status));
const logsWithRoutes = climbLogs.filter(l => l.data.routes.length > 0);
const logsWithoutRoutes = climbLogs
  .filter(l => l.data.routes.length === 0)
  .map(l => ({ slug: l.slug, date: l.data.date, crag: l.data.crag ?? null, title: l.data.title }))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());
const routeFillRate = climbLogs.length > 0
  ? Math.round((logsWithRoutes.length / climbLogs.length) * 100) : 0;

const partnerFreq = new Map<string, number>();
for (const log of allLogs) {
  for (const p of log.data.partners) {
    if (p && p !== '게스트') partnerFreq.set(p, (partnerFreq.get(p) ?? 0) + 1);
  }
}
const topPartners = [...partnerFreq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 18);
const maxPartnerCount = topPartners.length > 0 ? topPartners[0][1] : 1;

const cragFreq = new Map<string, number>();
for (const log of climbLogs) {
  if (log.data.crag) cragFreq.set(log.data.crag, (cragFreq.get(log.data.crag) ?? 0) + 1);
}
const topCrags = [...cragFreq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
const maxCragCount = topCrags.length > 0 ? topCrags[0][1] : 1;

const statusBuckets = new Map<string, number>();
for (const r of allRoutes) statusBuckets.set(r.status, (statusBuckets.get(r.status) ?? 0) + 1);
const totalRoutes = allRoutes.length;

const now = new Date();
const firstClimbDate = climbLogs.length > 0 ? climbLogs[0].data.date : now;
type MonthEntry = { year: number; month: number; label: string; newYear: boolean; count: number };
const months: MonthEntry[] = [];
const cur = new Date(firstClimbDate.getFullYear(), firstClimbDate.getMonth(), 1);
const endMonth = new Date(now.getFullYear(), now.getMonth(), 1);
while (cur <= endMonth) {
  const y = cur.getFullYear();
  const m = cur.getMonth();
  months.push({
    year: y, month: m + 1,
    label: `${m + 1}월`,
    newYear: m === 0,
    count: climbLogs.filter(l => l.data.date.getFullYear() === y && l.data.date.getMonth() === m).length,
  });
  cur.setMonth(cur.getMonth() + 1);
}
const maxMonthCount = Math.max(...months.map(m => m.count), 1);

const activeProjects = climbLogs.flatMap(log =>
  log.data.routes.filter(r => r.status === 'projecting').map(r => ({
    name: r.name ?? r.route_ref ?? '(미상)', grade: r.grade, attempts: r.attempts,
    logSlug: log.slug, logDate: log.data.date,
    crag: log.data.crag ? getCragTitle(log.data.crag) : null,
  }))
);

const uniqueCragCount = new Set(climbLogs.filter(l => l.data.crag).map(l => l.data.crag)).size;
const uniquePartnerCount = partnerFreq.size;
const firstDate = climbLogs[0]?.data.date;
const lastDate = climbLogs[climbLogs.length - 1]?.data.date;
const daysSinceStart = firstDate
  ? Math.floor((now.valueOf() - firstDate.valueOf()) / (1000 * 60 * 60 * 24)) : 0;
const avgPerMonth = months.length > 0 ? (climbLogs.length / months.length).toFixed(1) : '0';
const sendRate = totalRoutes > 0 ? Math.round((sends.length / totalRoutes) * 100) : 0;

// 인공암장(gym) 통계
const gymCragSlugs = new Set(
  allCrags
    .filter(c => c.data.crag_type.includes('gym'))
    .map(c => c.id.replace(/\.md$/, '').split('/').pop()!.normalize('NFC'))
);
const gymLogs = climbLogs.filter(l => l.data.crag && gymCragSlugs.has(l.data.crag.normalize('NFC')));
const gymRoutes = gymLogs.flatMap(l => l.data.routes);
const gymStyleCount = { '볼더링': 0, '지구력': 0, '리드': 0 };
for (const r of gymRoutes) {
  if (r.style === '볼더링') gymStyleCount['볼더링']++;
  else if (r.style === '지구력') gymStyleCount['지구력']++;
  else if (r.style === '리드') gymStyleCount['리드']++;
}
const gymCragFreq = new Map<string, number>();
for (const log of gymLogs) {
  if (log.data.crag) {
    const k = log.data.crag.normalize('NFC');
    gymCragFreq.set(k, (gymCragFreq.get(k) ?? 0) + 1);
  }
}
const topGymCrags = [...gymCragFreq.entries()].sort((a, b) => b[1] - a[1]);
const maxGymCount = topGymCrags.length > 0 ? topGymCrags[0][1] : 1;

const fmtPeriod = (d: Date) => `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}`;

// Grade timeline (sport/trad only — no V-grade bouldering)
function parseGradeNum(grade: string | null | undefined): number {
  if (!grade) return -1;
  const m = grade.match(/5\.(\d+)([a-dA-D]?)/i);
  if (!m) return -1;
  const base = parseInt(m[1], 10);
  const sub = m[2] ? { a: 0, b: 1, c: 2, d: 3 }[m[2].toLowerCase() as 'a'|'b'|'c'|'d'] ?? 0 : 0;
  return base * 4 + sub;
}
function gradeLabel(num: number): string {
  const major = Math.floor(num / 4);
  const sub = num % 4;
  return sub === 0 ? `5.${major}` : `5.${major}${'abcd'[sub]}`;
}

interface GradePoint { date: Date; grade: string; gradeNum: number; logSlug: string }
const gradeTimeline: GradePoint[] = [];
let runningMax = -1;
for (const log of climbLogs) {
  // PR 라인 — 모든 완등 기준 (선등/톱로핑 무관)
  const sends5x = log.data.routes
    .filter(r => sendSet.has(r.status) && parseGradeNum(r.grade) >= 0)
    .map(r => parseGradeNum(r.grade));
  if (sends5x.length === 0) continue;
  const sessionMax = Math.max(...sends5x);
  if (sessionMax > runningMax) {
    runningMax = sessionMax;
    gradeTimeline.push({ date: log.data.date, grade: gradeLabel(sessionMax), gradeNum: sessionMax, logSlug: log.slug });
  }
}
// 루트별 도트 — style: '선등' 만 파란 점, 나머지는 기본(녹색)
interface RouteDot { date: Date; gradeNum: number; grade: string; logSlug: string; isLead: boolean; isPR: boolean }
const routeDots: RouteDot[] = [];
{
  let pr = -1;
  for (const log of climbLogs) {
    const graded = log.data.routes.filter(r => sendSet.has(r.status) && parseGradeNum(r.grade) >= 0);
    for (const r of graded) {
      const gn = parseGradeNum(r.grade);
      const isLead = r.style === '선등';
      const isPR = gn > pr;
      if (gn > pr) pr = gn;
      routeDots.push({ date: log.data.date, gradeNum: gn, grade: gradeLabel(gn), logSlug: log.slug, isLead, isPR });
    }
  }
}

const hasGradeData = routeDots.length > 0;
const chartW = 800, chartH = 220;
const padL = 52, padR = 20, padT = 16, padB = 32;
const innerW = chartW - padL - padR;
const innerH = chartH - padT - padB;

let minGN = 0, maxGN = 0, xDomain: [Date, Date] = [new Date(), new Date()];
if (hasGradeData) {
  const nums = routeDots.map(d => d.gradeNum);
  minGN = Math.max(0, Math.min(...nums) - 1);
  maxGN = Math.max(...nums) + 1;
  xDomain = [climbLogs[0].data.date, climbLogs[climbLogs.length - 1].data.date];
}
const xScale = (d: Date) => {
  const [a, b] = xDomain;
  const t = b.valueOf() - a.valueOf();
  return t === 0 ? padL : padL + ((d.valueOf() - a.valueOf()) / t) * innerW;
};
const yScale = (g: number) => {
  const range = maxGN - minGN || 1;
  return padT + innerH - ((g - minGN) / range) * innerH;
};

// Y-axis ticks: one per major grade within range
const yTicks: { label: string; y: number }[] = [];
if (hasGradeData) {
  const minMajor = Math.floor(minGN / 4);
  const maxMajor = Math.ceil(maxGN / 4);
  for (let major = minMajor; major <= maxMajor; major++) {
    const gn = major * 4;
    if (gn < minGN || gn > maxGN) continue;
    yTicks.push({ label: `5.${major}`, y: yScale(gn) });
  }
}

// PR step line path
let prLinePath = '';
if (gradeTimeline.length > 0) {
  const pts = gradeTimeline.map(p => ({ x: xScale(p.date), y: yScale(p.gradeNum) }));
  prLinePath = pts.map((p, i) => {
    if (i === 0) return `M ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
    const prev = pts[i - 1];
    return `H ${p.x.toFixed(1)} V ${p.y.toFixed(1)}`;
  }).join(' ');
  // extend to end of chart
  prLinePath += ` H ${(padL + innerW).toFixed(1)}`;
}

// SVG Donut
function polarToXY(cx: number, cy: number, r: number, deg: number) {
  const rad = (deg - 90) * (Math.PI / 180);
  return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
}
interface DonutSeg { label: string; count: number; color: string; path: string }
const donutSegs: DonutSeg[] = [];
if (totalRoutes > 0) {
  const defs = [
    { label: '완등', count: sends.length, color: '#00e87a' },
    { label: '프로젝팅', count: statusBuckets.get('projecting') ?? 0, color: '#1e3a2a' },
    { label: '미완등', count: (statusBuckets.get('attempt')??0)+(statusBuckets.get('failed')??0), color: '#2a2a2a' },
  ].filter(s => s.count > 0);
  let angle = 0;
  for (const seg of defs) {
    const sweep = (seg.count / totalRoutes) * 358;
    let path: string;
    if (sweep >= 357) {
      path = `M 50 14 A 36 36 0 1 1 49.999 14`;
    } else {
      const s = polarToXY(50, 50, 36, angle);
      const e = polarToXY(50, 50, 36, angle + sweep);
      path = `M ${s.x.toFixed(2)} ${s.y.toFixed(2)} A 36 36 0 ${sweep > 180 ? 1 : 0} 1 ${e.x.toFixed(2)} ${e.y.toFixed(2)}`;
    }
    donutSegs.push({ ...seg, path });
    angle += sweep + 1;
  }
}

// ── Grade Pyramid ──
interface PyramidRow { label: string; gradeNum: number; onsight: number; flash: number; redpoint: number; send: number; total: number }
const pyramidMap = new Map<number, { onsight: number; flash: number; redpoint: number; send: number }>();
for (const r of allRoutes) {
  if (!sendSet.has(r.status)) continue;
  const gn = parseGradeNum(r.grade);
  if (gn < 0) continue;
  const bucket = pyramidMap.get(gn) ?? { onsight: 0, flash: 0, redpoint: 0, send: 0 };
  if (r.status === 'onsight') bucket.onsight++;
  else if (r.status === 'flash') bucket.flash++;
  else if (r.status === 'redpoint') bucket.redpoint++;
  else bucket.send++;
  pyramidMap.set(gn, bucket);
}
const pyramidRows: PyramidRow[] = [...pyramidMap.entries()]
  .sort((a, b) => b[0] - a[0])
  .map(([gn, c]) => ({
    label: gradeLabel(gn), gradeNum: gn,
    onsight: c.onsight, flash: c.flash, redpoint: c.redpoint, send: c.send,
    total: c.onsight + c.flash + c.redpoint + c.send,
  }));
const maxPyramidTotal = Math.max(...pyramidRows.map(r => r.total), 1);

// ── Personal Best ──
const pbByStat = (statuses: string[]): string | null => {
  const grades = allRoutes.filter(r => statuses.includes(r.status)).map(r => parseGradeNum(r.grade)).filter(g => g >= 0);
  return grades.length > 0 ? gradeLabel(Math.max(...grades)) : null;
};
const pbOnsight = pbByStat(['onsight']);
const pbFlash = pbByStat(['onsight', 'flash']);
const pbRedpoint = pbByStat(['onsight', 'flash', 'redpoint', 'send']);
---

<BaseLayout title="Stats">
<div class="stats-root">

  <!-- ══════════════════════════════════ HERO ══ -->
  <div class="hero">
    <div class="hero-head">
      <span class="hero-eyebrow mono">Stats · 기록 분석</span>
      {firstDate && lastDate && (
        <span class="hero-period mono">{fmtPeriod(firstDate)} → {fmtPeriod(lastDate)}</span>
      )}
    </div>
    <div class="hero-numbers">
      <div class="hnum">
        <div class="hnum-n">{climbLogs.length}</div>
        <div class="hnum-l">세션</div>
        <div class="hnum-s mono">{avgPerMonth}/월</div>
      </div>
      <div class="hdiv"></div>
      <div class="hnum">
        <div class="hnum-n">{sends.length}</div>
        <div class="hnum-l">완등</div>
        <div class="hnum-s mono">{totalRoutes > 0 ? `${sendRate}%` : '—'}</div>
      </div>
      <div class="hdiv"></div>
      <div class="hnum">
        <div class="hnum-n">{uniqueCragCount}</div>
        <div class="hnum-l">암장</div>
        <div class="hnum-s mono">/ {allCrags.length}개 등록</div>
      </div>
      <div class="hdiv"></div>
      <div class="hnum">
        <div class="hnum-n">{uniquePartnerCount}</div>
        <div class="hnum-l">파트너</div>
        <div class="hnum-s mono">함께 오른</div>
      </div>
      <div class="hdiv"></div>
      <div class="hnum">
        <div class="hnum-n">{daysSinceStart}</div>
        <div class="hnum-l">일째</div>
        <div class="hnum-s mono">등반 중</div>
      </div>
    </div>
  </div>

  <!-- ══════════════════════ DATA COMPLETENESS ══ -->
  {logsWithoutRoutes.length > 0 && (
    <section class="completeness-bar">
      <div class="cb-inner">
        <div class="cb-left">
          <span class="cb-label mono">루트 기입률</span>
          <div class="cb-track">
            <div class="cb-fill" style={`width:${routeFillRate}%`}></div>
          </div>
          <span class="cb-pct mono">{routeFillRate}%</span>
          <span class="cb-sub mono">({logsWithRoutes.length}/{climbLogs.length}세션)</span>
        </div>
        <details class="cb-detail">
          <summary class="cb-summary mono">미기입 {logsWithoutRoutes.length}건 ▾</summary>
          <div class="cb-list">
            {logsWithoutRoutes.map(l => {
              const d = l.date;
              const ds = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;
              return (
                <a href={`/logs/${l.slug}/`} class="cb-item">
                  <span class="cb-item-date mono">{ds}</span>
                  <span class="cb-item-crag">{l.crag ?? '암장 미기입'}</span>
                </a>
              );
            })}
          </div>
        </details>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════ ACTIVITY ══ -->
  <section class="section">
    <div class="section-inner">
      <div class="section-hd">
        <div class="s-eyebrow">Activity</div>
        <h2 class="s-title">월별 세션</h2>
      </div>
      <div class="chart-wrap">
        <div class="chart-yaxis">
          {[maxMonthCount, Math.ceil(maxMonthCount * 0.5), 0].map(v => (
            <div class="yval mono">{v}</div>
          ))}
        </div>
        <div class="chart-area">
          <div class="chart-grid-lines">
            <div class="gline"></div>
            <div class="gline"></div>
            <div class="gline"></div>
          </div>
          <div class="month-bars">
            {months.map(m => (
              <div class="mcol" title={`${m.year}년 ${m.label} — ${m.count}세션`}>
                {m.newYear && <div class="yr-mark mono">{m.year}</div>}
                <div class="mbar-wrap">
                  <div
                    class={`mbar${m.count === 0 ? ' mbar-empty' : ''}`}
                    style={`height:${m.count === 0 ? '2px' : `${Math.round((m.count/maxMonthCount)*100)}%`}`}
                  >
                    {m.count > 0 && <span class="mbar-tip mono">{m.count}</span>}
                  </div>
                </div>
                <div class="mlabel mono">{m.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════ CRAGS + PARTNERS ══ -->
  <section class="section section-tinted">
    <div class="section-inner two-col">

      <div class="col-panel">
        <div class="s-eyebrow">Crags</div>
        <h2 class="s-title">암장별 방문</h2>
        {topCrags.length > 0 ? (
          <div class="crag-bars">
            {topCrags.map(([slug, count]) => (
              <div class="cbar">
                <div class="cbar-hd">
                  <a href={`/crags/${slug}/`} class="cbar-name">{getCragTitle(slug)}</a>
                  <span class="cbar-ct mono">{count}회</span>
                </div>
                <div class="cbar-track">
                  <div class="cbar-fill" style={`width:${Math.round((count/maxCragCount)*100)}%`}></div>
                </div>
              </div>
            ))}
          </div>
        ) : <p class="empty-note">crag 필드를 채우면 표시됩니다.</p>}
      </div>

      <div class="col-panel">
        <div class="s-eyebrow">Partners</div>
        <h2 class="s-title">함께 오른 파트너</h2>
        {topPartners.length > 0 ? (
          <div class="pchips">
            {topPartners.map(([name, count]) => (
              <div
                class="pchip"
                style={`--freq: ${(count / maxPartnerCount).toFixed(2)}`}
                title={`${name} — ${count}회`}
              >
                <span class="pchip-n">{name}</span>
                <span class="pchip-c mono">{count}</span>
              </div>
            ))}
          </div>
        ) : <p class="empty-note">partners 필드를 채우면 표시됩니다.</p>}
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════ RESULTS ══ -->
  {totalRoutes > 0 && (
    <section class="section">
      <div class="section-inner">
        <div class="section-hd">
          <div class="s-eyebrow">Results</div>
          <h2 class="s-title">등반 결과</h2>
        </div>
        <div class="results-layout">
          <div class="donut-wrap">
            <svg viewBox="0 0 100 100" class="donut-svg">
              {donutSegs.map(s => (
                <path d={s.path} fill="none" stroke={s.color} stroke-width="16" stroke-linecap="butt"/>
              ))}
              <text x="50" y="46" text-anchor="middle" class="dt-pct">{sendRate}</text>
              <text x="50" y="58" text-anchor="middle" class="dt-lbl">% 완등</text>
            </svg>
            <div class="donut-legend">
              {donutSegs.map(s => (
                <div class="dleg">
                  <span class="dleg-dot" style={`background:${s.color}`}></span>
                  <span class="dleg-name">{s.label}</span>
                  <span class="dleg-n mono">{s.count}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="rcards">
            {[
              { n: sends.length, l: '완등', s: 'OS · FL · RP · Send', cls: 'rc-send' },
              { n: statusBuckets.get('projecting') ?? 0, l: '프로젝팅', s: '계속 작업 중', cls: 'rc-proj' },
              { n: (statusBuckets.get('attempt')??0)+(statusBuckets.get('failed')??0), l: '미완등', s: 'Attempt + Failed', cls: 'rc-fail' },
              { n: totalRoutes, l: '총 기록', s: `${logsWithRoutes.length}개 세션`, cls: 'rc-total' },
            ].map(c => (
              <div class={`rcard ${c.cls}`}>
                <div class="rcard-n">{c.n}</div>
                <div class="rcard-l">{c.l}</div>
                <div class="rcard-s">{c.s}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════ GRADE PYRAMID ══ -->
  {pyramidRows.length > 0 && (
    <section class="section section-tinted">
      <div class="section-inner">
        <div class="section-hd">
          <div class="s-eyebrow">Grade Pyramid</div>
          <h2 class="s-title">그레이드 피라미드</h2>
        </div>
        {(pbOnsight || pbFlash || pbRedpoint) && (
          <div class="pb-cards">
            {pbOnsight && (
              <div class="pb-card">
                <div class="pb-grade mono">{pbOnsight}</div>
                <div class="pb-label mono">Best Onsight</div>
              </div>
            )}
            {pbFlash && (
              <div class="pb-card">
                <div class="pb-grade mono">{pbFlash}</div>
                <div class="pb-label mono">Best Flash</div>
              </div>
            )}
            {pbRedpoint && (
              <div class="pb-card pb-card-rp">
                <div class="pb-grade mono">{pbRedpoint}</div>
                <div class="pb-label mono">Best Redpoint</div>
              </div>
            )}
          </div>
        )}
        <div class="pyramid-chart">
          {pyramidRows.map(row => (
            <div class="pyr-row">
              <div class="pyr-label mono">{row.label}</div>
              <div class="pyr-bars">
                <div class="pyr-track">
                  {row.onsight > 0 && (
                    <div class="pyr-seg pyr-os" style={`width:${(row.onsight/maxPyramidTotal)*100}%`} title={`온사이트 ${row.onsight}회`}></div>
                  )}
                  {row.flash > 0 && (
                    <div class="pyr-seg pyr-fl" style={`width:${(row.flash/maxPyramidTotal)*100}%`} title={`플래시 ${row.flash}회`}></div>
                  )}
                  {row.redpoint > 0 && (
