---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const logs = (await getCollection('logs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const allCrags = await getCollection('crags');

// NFC normalization
const cragTitleMap = new Map<string, string>();
const cragMountainMap = new Map<string, string>();
const cragSlugMap = new Map<string, string>(); // key → actual slug for link
for (const c of allCrags) {
  const key = c.id.replace(/\.md$/, '').split('/').pop()!.normalize('NFC');
  const slug = c.slug ?? c.id.replace(/\.md$/, '').split('/').pop()!;
  cragTitleMap.set(key, c.data.title);
  cragMountainMap.set(key, c.data.mountain ?? c.data.title);
  cragSlugMap.set(key, slug);
}
const getCragTitle   = (s: string) => cragTitleMap.get(s.normalize('NFC')) ?? s;
const getCragMountain= (s: string) => cragMountainMap.get(s.normalize('NFC')) ?? '';
const getCragSlug    = (s: string) => cragSlugMap.get(s.normalize('NFC')) ?? null;

const cragRouteNameMap = new Map<string, string>();
const cragTypeMap = new Map<string, string>();
for (const crag of allCrags) {
  for (const r of crag.data.routes) {
    if (r.name) cragRouteNameMap.set(r.id, r.name);
  }
  const key = crag.id.replace(/\.md$/, '').split('/').pop()!.normalize('NFC');
  const t = crag.data.crag_type;
  cragTypeMap.set(key,
    t.includes('multi-pitch') ? 'multi-pitch' :
    t.includes('hard-free')   ? 'hard-free'   :
    t.includes('gym')         ? 'gym'          : 'other'
  );
}
const getCragType = (s: string) => cragTypeMap.get(s.normalize('NFC')) ?? 'other';

const climbLogs = logs.filter(l => l.data.type !== 'misc');
const years = [...new Set(logs.map(l => l.data.date.getFullYear()))].sort().reverse();
const totalSends = climbLogs.reduce((s, l) =>
  s + l.data.routes.filter(r => ['onsight','flash','redpoint','send'].includes(r.status)).length, 0);
const mountainsInLogs = [...new Set(
  logs.map(l => l.data.crag ? getCragMountain(l.data.crag) : null).filter((m): m is string => !!m)
)].sort();

// 파트너 빈도 집계 → 2회 이상만 필터에 노출
const partnerFreq = new Map<string, number>();
for (const l of logs) {
  for (const p of l.data.partners) {
    if (p && p !== '게스트') partnerFreq.set(p, (partnerFreq.get(p) ?? 0) + 1);
  }
}
const partnersInLogs = [...partnerFreq.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1])
  .map(([p]) => p);

// Group by year
const logsByYear = new Map<number, typeof logs>();
for (const log of logs) {
  const y = log.data.date.getFullYear();
  if (!logsByYear.has(y)) logsByYear.set(y, []);
  logsByYear.get(y)!.push(log);
}
const yearGroups = [...logsByYear.entries()].sort((a, b) => b[0] - a[0]);

const now = new Date(); now.setHours(0,0,0,0);

const sLabel: Record<string,string> = { onsight:'OS', flash:'FL', redpoint:'RP', send:'SD', projecting:'PJ', attempt:'AT', failed:'—' };
const sGroup: Record<string,string> = { onsight:'send', flash:'send', redpoint:'send', send:'send', projecting:'project', attempt:'project', failed:'fail' };

const DAYS_KO = ['일','월','화','수','목','금','토'];
---
<BaseLayout title="등반 로그">
<div class="logs-root">

  <!-- ══════════════════════════ PAGE HEADER ══ -->
  <div class="page-hd">
    <div class="page-hd-inner">
      <div class="phd-left">
        <div class="s-eyebrow">Field Notes</div>
        <h1>기록의 <em>층위.</em></h1>
      </div>
      <div class="phd-right">
        <div class="phd-stats">
          <div class="pstat"><span class="pstat-n">{climbLogs.length}</span><span class="pstat-l">세션</span></div>
          <div class="pstat"><span class="pstat-n">{totalSends}</span><span class="pstat-l">완등</span></div>
          <div class="pstat"><span class="pstat-n">{years.length}</span><span class="pstat-l">년</span></div>
        </div>
        <div class="type-legend mono">
          <span class="tleg tleg--mp">■ 멀티피치</span>
          <span class="tleg tleg--hf">■ 하드프리</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════ FILTER BAR ══ -->
  <div class="filter-bar" id="filter-bar">
    <div class="filter-inner">
      <div class="filter-row">
        <button class="fpill active" data-type="year" data-value="all">전체</button>
        {years.map(y => (
          <button class="fpill" data-type="year" data-value={String(y)}>{y}</button>
        ))}
      </div>
      {mountainsInLogs.length > 0 && (
        <div class="filter-row">
          <button class="fpill active" data-type="mountain" data-value="all">모든 산</button>
          {mountainsInLogs.map(m => (
            <button class="fpill" data-type="mountain" data-value={m}>{m}</button>
          ))}
        </div>
      )}
      <div class="filter-row">
        <button class="fpill active" data-type="result" data-value="all">모든 결과</button>
        <button class="fpill" data-type="result" data-value="send">완등 있음</button>
        <button class="fpill" data-type="result" data-value="project">프로젝팅</button>
        <button class="fpill" data-type="result" data-value="none">루트 미기입</button>
      </div>
      {partnersInLogs.length > 0 && (
        <div class="filter-row">
          <button class="fpill active" data-type="partner" data-value="all">모든 파트너</button>
          {partnersInLogs.map(p => (
            <button class="fpill" data-type="partner" data-value={p}>{p}</button>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- ══════════════════════════════ LOG LIST ══ -->
  <div class="log-outer">
    <div class="log-inner">
      {yearGroups.map(([year, yearLogs]) => (
        <div class="year-section" data-year-group={String(year)}>
          <div class="year-marker">
            <span class="year-bg" aria-hidden="true">{year}</span>
            <span class="year-rule"></span>
            <span class="year-meta mono">{yearLogs.filter(l=>l.data.type!=='misc').length} 세션</span>
          </div>
          <div class="year-entries">
            {yearLogs.map(log => {
              const cs = log.data.crag;
              const cragTitle = cs ? getCragTitle(cs) : null;
              const cragLinkSlug = cs ? getCragSlug(cs) : null;
              const mountain = cs ? getCragMountain(cs) : '';
              const sends = log.data.routes.filter(r=>['onsight','flash','redpoint','send'].includes(r.status)).length;
              const hasProj = log.data.routes.some(r=>r.status==='projecting');
              const d = log.data.date;
              const isUpcoming = d >= now;
              const resultKey = log.data.routes.length === 0 ? 'none' : sends > 0 ? 'send' : hasProj ? 'project' : 'fail';
              const cragType = cs ? getCragType(cs) : 'other';

              return (
                <article
                  class={['entry', isUpcoming && 'entry--upcoming', log.data.type==='misc' && 'entry--misc'].filter(Boolean).join(' ')}
                  data-year={String(d.getFullYear())}
                  data-mountain={mountain}
                  data-result={resultKey}
                  data-cragtype={cragType}
                  data-partners={log.data.partners.filter(p => p && p !== '게스트').join(',')}
                >
                  <div class="entry-date">
                    <span class={`ed-day ed-day--${cragType}`}>{String(d.getDate()).padStart(2,'0')}</span>
                    <span class="ed-dow mono">{DAYS_KO[d.getDay()]}</span>
                    <span class="ed-mon mono">{String(d.getMonth()+1).padStart(2,'0')}월</span>
                    {cragType === 'multi-pitch' && <span class="ed-type ed-type--mp mono">MP</span>}
                    {cragType === 'hard-free'   && <span class="ed-type ed-type--hf mono">HF</span>}
                  </div>
                  <div class="entry-body">
                    <div class="entry-meta">
                      {log.data.type==='misc' && <span class="badge-misc">기타</span>}
                      {cragTitle && (
                        cragLinkSlug
                          ? <a href={`/crags/${cragLinkSlug}/`} class="badge-crag">{cragTitle}</a>
                          : <span class="badge-crag">{cragTitle}</span>
                      )}
                      {log.data.crew.length > 0 && <span class="badge-crew">{log.data.crew.join(', ')}</span>}
                      {isUpcoming && <span class="badge-upcoming">예정</span>}
                    </div>
                    <h2 class="entry-title">
                      <a href={`/logs/${log.slug}/`}>{log.data.title}</a>
                    </h2>
                    {log.data.routes.length > 0 && (
                      <ul class="chips">
                        {log.data.routes.slice(0,5).map(r => (
                          <li class={`chip chip-${sGroup[r.status]}`}>
                            <span class="chip-name">{r.name ?? (r.route_ref ? (cragRouteNameMap.get(r.route_ref)??r.route_ref) : '?')}</span>
                            {r.grade && <span class="chip-grade">{r.grade}</span>}
                            <span class="chip-st">{sLabel[r.status]}</span>
                          </li>
                        ))}
                        {log.data.routes.length > 5 && <li class="chip chip-more">+{log.data.routes.length-5}</li>}
                      </ul>
                    )}
                  </div>
                  <div class="entry-result">
                    {!isUpcoming && log.data.routes.length > 0 && sends > 0 && (
                      <span class="res-send"><em>{sends}</em><small>SENT</small></span>
                    )}
                    {!isUpcoming && log.data.routes.length > 0 && sends === 0 && hasProj && (
                      <span class="res-proj">PJ</span>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      ))}
      <p class="empty-msg" id="empty-msg" style="display:none">해당 조건의 기록이 없습니다.</p>
    </div>
  </div>

</div>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.fpill');
  const entries = document.querySelectorAll<HTMLElement>('.entry');
  const yearSections = document.querySelectorAll<HTMLElement>('.year-section');
  const emptyMsg = document.getElementById('empty-msg')!;

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type!;
      document.querySelectorAll<HTMLButtonElement>(`.fpill[data-type="${type}"]`)
        .forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filter();
    });
  });

  function filter() {
    const year    = document.querySelector<HTMLButtonElement>('.fpill[data-type="year"].active')?.dataset.value ?? 'all';
    const mt      = document.querySelector<HTMLButtonElement>('.fpill[data-type="mountain"].active')?.dataset.value ?? 'all';
    const result  = document.querySelector<HTMLButtonElement>('.fpill[data-type="result"].active')?.dataset.value ?? 'all';
    const partner = document.querySelector<HTMLButtonElement>('.fpill[data-type="partner"].active')?.dataset.value ?? 'all';
    let vis = 0;
    entries.forEach(e => {
      const partners = (e.dataset.partners ?? '').split(',').filter(Boolean);
      const show =
        (year==='all'    || e.dataset.year===year) &&
        (mt==='all'      || e.dataset.mountain===mt) &&
        (result==='all'  || e.dataset.result===result) &&
        (partner==='all' || partners.includes(partner));
      e.style.display = show ? '' : 'none';
      if (show) vis++;
    });
    yearSections.forEach(s => {
      const y = s.dataset.yearGroup;
      const hasVis = [...s.querySelectorAll<HTMLElement>('.entry')].some(e=>e.style.display!=='none');
      s.style.display = hasVis ? '' : 'none';
    });
    emptyMsg.style.display = vis===0 ? '' : 'none';
  }
</script>

<style>
  .logs-root { min-height: 100vh; padding-bottom: 6rem; }

  /* ── PAGE HEADER ── */
  .page-hd {
    padding: 4.5rem 2rem 3.5rem;
    border-bottom: 1px solid var(--rule-strong);
  }
  .page-hd-inner {
    max-width: 1100px; margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .s-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--stone-500);
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-bottom: 0.8rem;
  }
  .s-eyebrow::before {
    content: '';
    display: inline-block;
    width: 16px; height: 1px;
    background: var(--ochre);
  }
  h1 {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0;
  }
  h1 em {  color: var(--ochre); font-weight: 300; }

  .phd-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.75rem; }
  .phd-stats { display: flex; gap: 2.5rem; align-items: flex-end; }
  .type-legend { display: flex; gap: 1rem; font-size: 0.6rem; letter-spacing: 0.1em; }
  .tleg { opacity: 0.7; }
  .tleg--mp { color: #4a9eff; }
  .tleg--hf { color: var(--ochre); }
  .pstat { text-align: right; }
  .pstat-n {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 2.4rem;
    font-weight: 600;
    display: block;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .pstat-l {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone-500);
    display: block;
    margin-top: 0.2rem;
  }

  /* ── FILTER BAR ── */
  .filter-bar {
    position: sticky;
    top: 56px;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 95%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 2rem;
  }
  .filter-inner { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.4rem; }
  .filter-row { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .fpill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.28em 0.9em;
    border: 1px solid var(--rule-strong);
    background: transparent;
    color: var(--stone-700);
    cursor: pointer;
    border-radius: 100px;
    transition: all 0.12s;
    line-height: 1.7;
  }
  .fpill:hover { border-color: var(--ochre); color: var(--ochre); }
  .fpill.active { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  /* ── LOG OUTER ── */
  .log-outer { padding: 0 2rem 0; }
  .log-inner { max-width: 1100px; margin: 0 auto; }

  /* ── YEAR SECTION ── */
  .year-section { padding-top: 3rem; }
  .year-section + .year-section { border-top: 1px solid var(--rule); }
  .year-marker {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
    position: relative;
  }
  .year-bg {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--stone-200);
    line-height: 1;
    letter-spacing: -0.06em;
    user-select: none;
    font-variant-numeric: tabular-nums;
  }
  .year-rule {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
  .year-meta {
    font-size: 0.65rem;
    color: var(--stone-500);
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }
  .year-entries { display: flex; flex-direction: column; }

  /* ── ENTRY (LOG CARD) ── */
  .entry {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    gap: 1.5rem;
    padding: 1.5rem 0 1.5rem 1rem;
    border-bottom: 1px solid var(--rule);
    border-left: 2.5px solid transparent;
    align-items: start;
    transition: background 0.12s, border-left-color 0.12s;
  }
  .entry:first-child { border-top: 1px solid var(--rule); }
  .entry[data-result="send"]    { border-left-color: var(--moss); }
  .entry[data-result="project"] { border-left-color: color-mix(in srgb, var(--ochre) 55%, transparent); }
  .entry[data-result="fail"]    { border-left-color: var(--stone-300); }
  .entry:hover { background: color-mix(in srgb, var(--ochre) 3%, transparent); }
  .entry--misc { opacity: 0.45; }
  .entry--misc:hover { opacity: 0.75; }
  .entry--upcoming { opacity: 0.55; border-bottom-style: dashed; }

  /* Date column */
  .entry-date { text-align: right; padding-top: 0.15rem; }
  .ed-day {
    display: block;
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 1.9rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .ed-dow {
    display: block;
    font-size: 0.58rem;
    color: var(--stone-500);
    letter-spacing: 0.06em;
    margin-top: 0.25rem;
  }
  .ed-mon {
    display: block;
    font-size: 0.58rem;
    color: var(--stone-500);
    letter-spacing: 0.04em;
    margin-top: 0.1rem;
  }
  /* 암장 타입별 날짜 색상 */
  .ed-day--multi-pitch { color: #4a9eff; }
  .ed-day--hard-free   { color: var(--ochre); }
  .ed-day--gym         { color: var(--stone-700); }
  /* 타입 레이블 (날짜 아래) */
  .ed-type {
    display: block;
    font-size: 0.46rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 0.35rem;
    text-align: right;
    line-height: 1;
  }
  .ed-type--mp { color: #4a9eff; }
  .ed-type--hf { color: var(--ochre); }

  /* Body */
  .entry-body { min-width: 0; }
  .entry-meta { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; margin-bottom: 0.5rem; }

  .badge-crag, .badge-crew, .badge-misc, .badge-upcoming {
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.15em 0.55em;
    border-radius: 2px;
    letter-spacing: 0.03em;
  }
  .badge-crag {
    background: color-mix(in srgb, var(--ochre) 9%, transparent);
    color: var(--ochre);
    border: 1px solid color-mix(in srgb, var(--ochre) 20%, transparent);
  }
  a.badge-crag { border-bottom: none; }
  a.badge-crag:hover { color: var(--ochre); background: color-mix(in srgb, var(--ochre) 15%, transparent); }
  .badge-crew { background: var(--stone-100); color: var(--stone-700); border: 1px solid var(--rule); }
  .badge-misc, .badge-upcoming { background: var(--stone-100); color: var(--stone-500); border: 1px solid var(--rule); font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; }

  .entry-title {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 1.3rem;
    font-weight: 400;
    margin: 0 0 0.65rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }
  .entry-title a { border: none; color: var(--ink); }
  .entry-title a:hover { color: var(--ochre); }

  /* Route chips */
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 0.28rem; padding: 0; margin: 0; }
  .chip {
    display: flex;
    align-items: center;
    gap: 0.32em;
    font-size: 0.67rem;
    padding: 0.2em 0.5em;
    border: 1px solid;
    border-radius: 2px;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: 0.02em;
  }
  .chip-send    { color: var(--moss); border-color: color-mix(in srgb, var(--moss) 35%, transparent); background: color-mix(in srgb, var(--moss) 5%, transparent); }
  .chip-project { color: var(--ochre); border-color: color-mix(in srgb, var(--ochre) 30%, transparent); background: color-mix(in srgb, var(--ochre) 4%, transparent); }
  .chip-fail    { color: var(--stone-500); border-color: var(--rule); background: transparent; }
  .chip-more    { color: var(--stone-500); border-color: var(--rule); background: transparent; }
  .chip-name    { font-family: 'Spoqa Han Sans Neo', sans-serif; font-weight: 500; font-size: 0.7rem; }
  .chip-grade   { opacity: 0.6; }
  .chip-st      { font-weight: 600; letter-spacing: 0.07em; }

  /* Result column */
  .entry-result { padding-top: 0.15rem; text-align: right; flex-shrink: 0; }
  .res-send {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--moss);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1;
    gap: 0.12rem;
    letter-spacing: -0.04em;
  }
  .res-send small {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    color: var(--moss);
    opacity: 0.6;
  }
  .res-proj {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--ochre);
    padding: 0.22em 0.45em;
    border: 1px solid color-mix(in srgb, var(--ochre) 32%, transparent);
  }

  .mono { font-family: 'JetBrains Mono', monospace; }
  .empty-msg {
    text-align: center;
    padding: 5rem 0;
    color: var(--stone-500);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }

  @media (max-width: 720px) {
