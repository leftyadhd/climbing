---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const logs = (await getCollection('logs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// 연도별 그룹
const byYear: Record<string, typeof logs> = {};
logs.forEach(log => {
  const y = log.data.date.getFullYear().toString();
  if (!byYear[y]) byYear[y] = [];
  byYear[y].push(log);
});
const years = Object.keys(byYear).sort().reverse();
---
<BaseLayout title="등반로그">
<div class="container">
  <div class="eyebrow">Field Notes — 등반 기록</div>
  <h1>돌 위에서의<br/><em style="font-style:italic; color:var(--ochre);">날들.</em></h1>
  <p style="font-size:1.1rem; max-width:560px; color:var(--stone-700); margin-top:1.5rem;">
    잡은 홀드와 놓친 무브. 함께한 사람들과 바람의 방향. 기억은 바위보다 짧으니, 여기에 남깁니다.
  </p>
  <div class="meta" style="margin-top:2rem;">총 {logs.length}개 세션 · {years.length}년간의 기록</div>

  <hr class="rule" />

  {years.map(year => (
    <section class="year-section">
      <div class="year-head">
        <span class="year-num">{year}</span>
        <span class="year-count">{byYear[year].length.toString().padStart(2,'0')} sessions</span>
      </div>

      <ul class="log-list">
        {byYear[year].map(log => (
          <li>
            <a href={`/logs/${log.slug}/`}>
              <div class="log-date">{log.data.date.toISOString().slice(5,10).replace('-', '.')}</div>
              <div class="log-main">
                <div class="log-title-row">{log.data.title}</div>
                <div class="log-details">
                  {log.data.crag && <span>{log.data.crag}</span>}
                  {log.data.weather && <span>{log.data.weather}</span>}
                  {log.data.routes.length > 0 && (
                    <span>루트 {log.data.routes.length}개</span>
                  )}
                </div>
              </div>
              {log.data.routes.length > 0 && (
                <div class="log-stats">
                  {(() => {
                    const sends = log.data.routes.filter(r => ['onsight','flash','redpoint','send'].includes(r.status)).length;
                    return sends > 0 ? `${sends} sent` : 'project';
                  })()}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  h1 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    line-height: 1;
  }
  .year-section { margin: 3rem 0; }
  .year-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--rule-strong);
    margin-bottom: 1rem;
  }
  .year-num {
    font-family: 'Fraunces', serif;
    font-size: 2.5rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .year-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone-500);
  }

  .log-list { list-style: none; margin: 0; padding: 0; }
  .log-list li { border-bottom: 1px solid var(--rule); }
  .log-list li:last-child { border-bottom: none; }
  .log-list a {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: 1.5rem;
    padding: 1.2rem 0.5rem;
    border: none;
    color: var(--ink);
    align-items: baseline;
    transition: background 0.15s, padding 0.15s;
  }
  .log-list a:hover {
    background: color-mix(in srgb, var(--ochre) 5%, transparent);
    padding-left: 1rem;
    color: var(--ink);
  }

  .log-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--stone-500);
    letter-spacing: 0.05em;
  }
  .log-title-row {
    font-family: 'Fraunces', serif;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .log-details {
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: var(--stone-700);
    margin-top: 0.3rem;
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .log-stats {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ochre);
    padding: 0.3em 0.8em;
    border: 1px solid var(--ochre);
    align-self: center;
  }

  @media (max-width: 640px) {
    .log-list a { grid-template-columns: 50px 1fr; gap: 1rem; padding: 1rem 0; }
    .log-stats { grid-column: 2; justify-self: start; margin-top: 0.5rem; }
    .log-title-row { font-size: 1.1rem; }
  }
</style>
</BaseLayout>
