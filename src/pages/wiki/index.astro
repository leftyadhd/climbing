---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const all = await getCollection('wiki');
const techniques = all.filter(e => e.data.type === 'technique');
const grouped = {
  guide: all.filter(e => e.data.type === 'guide'),
  gear:  all.filter(e => e.data.type === 'gear'),
};

const diffLabel: Record<string, string> = {
  beginner: '입문',
  intermediate: '중급',
  advanced: '고급',
};

// 7개 기술 카테고리
const techCategories: { tag: string; label: string; desc: string }[] = [
  { tag: '슬랩',      label: '슬랩',      desc: '마찰력과 밸런스로 오르는 완경사 바위.' },
  { tag: '하강',      label: '하강',      desc: '로프를 타고 안전하게 내려오는 법.' },
  { tag: '확보',      label: '확보',      desc: '파트너를 붙잡는 기술 전반.' },
  { tag: '크랙',      label: '크랙',      desc: '바위 틈새에 손발을 잼밍하는 기술.' },
  { tag: '후등자확보', label: '후등자 확보', desc: '선등자가 위에서 후등자를 확보하는 법.' },
  { tag: '선등자확보', label: '선등자 확보', desc: '선등하며 중간 확보물을 설치하는 법.' },
  { tag: '볼트밟기',   label: '볼트 밟기', desc: '볼트와 퀵드로를 발판 삼아 이동하는 법.' },
];

// 태그로 카테고리 매핑, 미분류는 별도 수집
const categorized = new Set<string>();
const techByCategory = techCategories.map(cat => {
  const items = techniques.filter(t => t.data.tags.includes(cat.tag));
  items.forEach(t => categorized.add(t.slug));
  return { ...cat, items };
});
const uncategorized = techniques.filter(t => !categorized.has(t.slug));

// 입문 경로
const beginnerPath = [
  ...grouped.guide.slice(0, 1),
  ...grouped.gear.slice(0, 1),
  ...techniques.filter(t => t.data.difficulty_level === 'beginner').slice(0, 1),
];

const typeKo: Record<string, string> = {
  guide: '가이드', gear: '장비', technique: '기술',
};

type SectionKey = 'gear' | 'guide';
const supportSections: { key: SectionKey; label: string; roman: string; desc: string }[] = [
  { key: 'gear',  label: '장비',   roman: 'II',  desc: '생명줄이 되는 물건들.' },
  { key: 'guide', label: '가이드', roman: 'III', desc: '입문, 안전, 그리고 문화.' },
];
---
<BaseLayout title="위키">
<div class="container">

  <div class="eyebrow">The Wiki — 서가</div>
  <h1>배움이 <em>쌓이는 곳.</em></h1>
  <p class="intro">
    루트를 가기 전에 한 번, 다녀와서 다시 한 번.<br/>
    직접 쓰고 고치며 지식이 깊어집니다.
  </p>

  <!-- 입문자 경로 -->
  {beginnerPath.length > 0 && (
    <section class="path-section">
      <div class="path-label">
        <span class="path-badge">START</span>
        처음 시작한다면 이 순서로
      </div>
      <div class="path-steps">
        {beginnerPath.map((entry, i) => (
            <div class="path-step">
              {i > 0 && <span class="path-arrow">→</span>}
              <a href={`/wiki/${entry.slug}/`} class="path-card">
                <span class="path-type">{typeKo[entry.data.type]}</span>
                <span class="path-title">{entry.data.title}</span>
              </a>
            </div>
        ))}
      </div>
    </section>
  )}

  <hr class="rule" style="margin: 3rem 0;" />

  <!-- I. 기술 · 무브 — 7개 카테고리 -->
  <section class="wiki-section">
    <div class="section-head">
      <span class="roman">I</span>
      <div class="section-info">
        <h2>기술 · 무브</h2>
        <p class="section-desc">손과 발로 몸을 움직이는 법.</p>
      </div>
      <span class="section-count">{String(techniques.length).padStart(2, '0')}</span>
    </div>

    <div class="tech-grid">
      {techByCategory.map(cat => (
        <div class="tech-cat">
          <div class="tech-cat-head">
            <span class="tech-cat-label">{cat.label}</span>
            <span class="tech-cat-desc">{cat.desc}</span>
          </div>
          {cat.items.length > 0 ? (
            <ul class="wiki-list">
              {cat.items.map(item => (
                <li>
                  <a href={`/wiki/${item.slug}/`} class="wiki-row">
                    <div class="wiki-row-main">
                      <span class="wiki-title">{item.data.title}</span>
                      {item.data.summary && (
                        <span class="wiki-summary">{item.data.summary}</span>
                      )}
                    </div>
                    {item.data.difficulty_level && (
                      <span class={`diff-badge diff-${item.data.difficulty_level}`}>
                        {diffLabel[item.data.difficulty_level]}
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="tech-cat-empty">아직 작성된 문서 없음</div>
          )}
        </div>
      ))}
    </div>

    {uncategorized.length > 0 && (
      <div class="tech-cat tech-cat--misc">
        <div class="tech-cat-head">
          <span class="tech-cat-label">기타</span>
          <span class="tech-cat-desc">카테고리 미분류 기술 문서.</span>
        </div>
        <ul class="wiki-list">
          {uncategorized.map(item => (
            <li>
              <a href={`/wiki/${item.slug}/`} class="wiki-row">
                <div class="wiki-row-main">
                  <span class="wiki-title">{item.data.title}</span>
                  {item.data.summary && (
                    <span class="wiki-summary">{item.data.summary}</span>
                  )}
                </div>
                {item.data.difficulty_level && (
                  <span class={`diff-badge diff-${item.data.difficulty_level}`}>
                    {diffLabel[item.data.difficulty_level]}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>

  <!-- II·III·IV 섹션 -->
  {supportSections.map(({ key, label, roman, desc }) => {
    const items = grouped[key];
    if (items.length === 0) return null;
    return (
      <section class="wiki-section">
        <div class="section-head">
          <span class="roman">{roman}</span>
          <div class="section-info">
            <h2>{label}</h2>
            <p class="section-desc">{desc}</p>
          </div>
          <span class="section-count">{String(items.length).padStart(2, '0')}</span>
        </div>
        <ul class="wiki-list">
          {items.map(item => (
            <li>
              <a href={`/wiki/${item.slug}/`} class="wiki-row">
                <div class="wiki-row-main">
                  <span class="wiki-title">{item.data.title}</span>
                  {item.data.summary && (
                    <span class="wiki-summary">{item.data.summary}</span>
                  )}
                </div>
                <div class="wiki-row-badges">
                  {item.data.type === 'gear' && item.data.gear_category && (
                    <span class="region-badge">{item.data.gear_category}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
        <a href="#" class="add-hint" title="Admin에서 추가하세요">
          + 문서 추가하기 →
        </a>
      </section>
    );
  })}

</div>

<style>
  h1 {
    font-family: 'Fraunces', 'Hahmlet', serif;
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  h1 em { font-style: italic; color: var(--ochre); }
  .intro {
    font-size: 1.05rem;
    color: var(--stone-700);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  /* 입문 경로 */
  .path-section {
    background: var(--paper-soft);
    border: 1px solid var(--rule-strong);
    padding: 1.5rem 2rem;
    margin-bottom: 0;
  }
  .path-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-700);
    margin-bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.8em;
  }
  .path-badge {
    background: var(--ochre);
    color: var(--paper);
    padding: 0.15em 0.5em;
    font-size: 0.62rem;
    letter-spacing: 0.15em;
  }
  .path-steps {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .path-step { display: flex; align-items: center; gap: 0.5rem; }
  .path-arrow {
    color: var(--stone-300);
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .path-card {
    display: flex;
    flex-direction: column;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--rule-strong);
    background: var(--paper);
    min-width: 100px;
    transition: all 0.15s;
    border-bottom: none;
  }
  .path-card:hover { border-color: var(--ochre); color: var(--ink); }
  .path-type {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 0.2rem;
  }
  .path-title {
    font-family: 'Hahmlet', serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink);
  }

  /* 기술 카테고리 그리드 */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 0;
    margin-top: 0;
    border-left: 1px solid var(--rule);
    border-top: 1px solid var(--rule);
  }
  .tech-cat {
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.2rem 1.4rem;
  }
  .tech-cat--misc {
    grid-column: 1 / -1;
    border-right: 1px solid var(--rule);
  }
  .tech-cat-head {
    margin-bottom: 0.8rem;
  }
  .tech-cat-label {
    display: block;
    font-family: 'Hahmlet', serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.2rem;
  }
  .tech-cat-desc {
    display: block;
    font-size: 0.78rem;
    color: var(--stone-500);
    line-height: 1.4;
  }
  .tech-cat-empty {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--stone-300);
    padding: 0.5rem 0;
    border-top: 1px dashed var(--rule);
  }
  .tech-cat .wiki-list li:first-child { border-top: 1px solid var(--rule); }
  .tech-cat .wiki-row { padding: 0.7rem 0; }

  /* 카테고리 섹션 */
  .wiki-section { margin-top: 3.5rem; }
  .section-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 0;
  }
  .roman {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ochre);
  }
  .section-info h2 { margin: 0; font-size: 1.6rem; }
  .section-desc {
    font-size: 0.88rem;
    color: var(--stone-700);
    margin-top: 0.2rem;
  }
  .section-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--stone-500);
    letter-spacing: 0.1em;
  }

  /* 위키 행 */
  .wiki-list { list-style: none; margin: 0; padding: 0; }
  .wiki-list li { border-bottom: 1px solid var(--rule); }
  .wiki-list li:last-child { border-bottom: none; }

  .wiki-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0.5rem;
    border: none;
    color: var(--ink);
    transition: padding 0.15s, background 0.15s;
  }
  .wiki-row:hover {
    padding-left: 1rem;
    background: color-mix(in srgb, var(--ochre) 4%, transparent);
    color: var(--ink);
  }
  .wiki-row-main { min-width: 0; }
  .wiki-title {
    font-family: 'Hahmlet', 'Fraunces', serif;
    font-size: 1.15rem;
    font-weight: 400;
    display: block;
  }
  .wiki-summary {
    font-size: 0.85rem;
    color: var(--stone-700);
    display: block;
    margin-top: 0.2rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 480px;
  }
  .wiki-row-badges {
    display: flex;
    gap: 0.4rem;
    flex-shrink: 0;
    align-items: center;
  }

  /* 배지 */
  .diff-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    padding: 0.2em 0.6em;
    border: 1px solid;
    border-radius: 2px;
  }
  .diff-beginner  { color: var(--moss); border-color: color-mix(in srgb, var(--moss) 40%, transparent); }
  .diff-intermediate { color: var(--ochre); border-color: color-mix(in srgb, var(--ochre) 40%, transparent); }
  .diff-advanced  { color: var(--ink); border-color: var(--rule-strong); }
  .region-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    padding: 0.2em 0.6em;
    background: var(--stone-100);
    color: var(--stone-700);
    border-radius: 2px;
  }

  /* 문서 추가 힌트 */
  .add-hint {
    display: block;
    margin-top: 0.8rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--stone-500);
    border: none;
    border-bottom: 1px dashed var(--rule-strong);
    width: fit-content;
  }
  .add-hint:hover { color: var(--ochre); border-bottom-color: var(--ochre); }

  @media (max-width: 640px) {
    .path-section { padding: 1.2rem; }
    .path-steps { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
    .path-arrow { transform: rotate(90deg); }
    .wiki-summary { display: none; }
    .section-head { grid-template-columns: auto 1fr; }
    .section-count { display: none; }
  }
</style>
</BaseLayout>
