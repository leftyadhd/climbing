---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 2;

const entrySlug = entry.slug.split('/').pop();
const allLogs = await getCollection('logs');

const relatedLogs = entry.data.type === 'technique'
  ? allLogs
      .filter(l => l.data.routes.some(r => r.techniques_used.includes(entrySlug!)))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : [];

const typeLabel: Record<string, string> = {
  technique: '기술',
  gear: '장비',
  guide: '가이드',
  term: '용어',
};
const diffLabel: Record<string, string> = {
  beginner: '입문',
  intermediate: '중급',
  advanced: '고급',
};

const allWikiForNext = await getCollection('wiki');
let nextReads = allWikiForNext
  .filter(w => w.slug !== entry.slug)
  .filter(w => {
    if (entry.data.type === 'technique' && entry.data.related_techniques.length > 0)
      return entry.data.related_techniques.some(rt => w.slug.endsWith(rt));
    return w.data.type === entry.data.type;
  })
  .slice(0, 3);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
<article data-pagefind-body data-pagefind-filter="section:wiki">
<div class={hasToc ? 'wiki-wrap wiki-wrap--toc' : 'wiki-wrap'}>

  <div class="wiki-body">
    <div class="doc-meta">
      <a href="/wiki/">← Wiki</a>
      <span class="dot">·</span>
      <span class="doc-type">{typeLabel[entry.data.type]}</span>
      {entry.data.type === 'technique' && entry.data.difficulty_level && (
        <>
          <span class="dot">·</span>
          <span class={`diff-badge diff-${entry.data.difficulty_level}`}>
            {diffLabel[entry.data.difficulty_level]}
          </span>
        </>
      )}
      {entry.data.updated && (
        <>
          <span class="dot">·</span>
          <span>Updated {entry.data.updated.toISOString().slice(0,10)}</span>
        </>
      )}
    </div>

    <h1>{entry.data.title}</h1>

    {entry.data.summary && (
      <p class="summary">{entry.data.summary}</p>
    )}

    {entry.data.type === 'technique' && (
      <div class="data-box">
        {entry.data.difficulty_level && (
          <div class="data-row">
            <span class="data-label">난이도</span>
            <span>{entry.data.difficulty_level}</span>
          </div>
        )}
        {entry.data.common_on.length > 0 && (
          <div class="data-row">
            <span class="data-label">주 사용처</span>
            <span>{entry.data.common_on.join(' · ')}</span>
          </div>
        )}
      </div>
    )}

    {entry.data.type === 'gear' && (
      <div class="data-box">
        {entry.data.brand && (
          <div class="data-row">
            <span class="data-label">브랜드</span>
            <span>{entry.data.brand}</span>
          </div>
        )}
        {entry.data.gear_category && (
          <div class="data-row">
            <span class="data-label">분류</span>
            <span>{entry.data.gear_category}</span>
          </div>
        )}
        {entry.data.price_krw && (
          <div class="data-row">
            <span class="data-label">가격</span>
            <span class="mono">₩ {entry.data.price_krw.toLocaleString()}</span>
          </div>
        )}
      </div>
    )}

    {entry.data.tags.length > 0 && (
      <div class="tags">
        {entry.data.tags.map(t => <span class="tag">{t}</span>)}
      </div>
    )}

    <hr class="rule" />

    <div class="prose">
      <Content />
    </div>

    {relatedLogs.length > 0 && (
      <section class="related">
        <hr class="rule-ornate" />
        <div class="eyebrow">Connected — 관련 기록</div>
        <h2 style="margin-top:0.5rem;">이 {typeLabel[entry.data.type]}과 함께한 날들</h2>
        <ul class="related-list">
          {relatedLogs.map(log => (
            <li>
              <a href={`/logs/${log.slug}/`}>
                <span class="related-date">{log.data.date.toISOString().slice(0,10)}</span>
                <span class="related-title">{log.data.title}</span>
                {log.data.weather && <span class="related-weather">{log.data.weather}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {nextReads.length > 0 && (
      <section class="next-reads">
        <hr class="rule-ornate" />
        <div class="eyebrow">다음으로 읽을 것</div>
        <div class="next-grid">
          {nextReads.map(item => (
            <a href={`/wiki/${item.slug}/`} class="next-card">
              <span class="next-type">{typeLabel[item.data.type]}</span>
              <span class="next-title">{item.data.title}</span>
              {item.data.summary && <span class="next-summary">{item.data.summary}</span>}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  {hasToc && (
    <aside class="wiki-toc" data-pagefind-ignore>
      <nav class="toc-nav">
        <p class="toc-label">Contents</p>
        <ul>
          {tocHeadings.map(h => (
            <li class={`toc-item toc-h${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )}

</div>
</article>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-nav a');
  if (links.length > 0) {
    const headingEls = document.querySelectorAll<HTMLElement>('.prose h2, .prose h3');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            links.forEach(a => a.classList.remove('active'));
            document.querySelector(`.toc-nav a[href="#${id}"]`)?.classList.add('active');
          }
        }
      },
      { rootMargin: '-8% 0% -80% 0%' }
    );
    headingEls.forEach(el => observer.observe(el));
  }
</script>

<style>
  /* ── 레이아웃 ── */
  .wiki-wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }
  .wiki-wrap--toc {
    max-width: 1060px;
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 5rem;
    align-items: start;
  }

  /* ── TOC 사이드바 ── */
  .wiki-toc {
    position: sticky;
    top: 88px;
  }
  .toc-nav {
    border-left: 2px solid var(--rule);
    padding-left: 1.25rem;
  }
  .toc-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 0.75rem;
  }
  .toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .toc-item a {
    display: block;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--stone-500);
    border: none;
    padding: 0.3rem 0;
    transition: color 0.15s;
    word-break: keep-all;
  }
  .toc-item a:hover { color: var(--ink); border: none; }
  .toc-item a.active {
    color: var(--ochre);
    font-weight: 500;
  }
  .toc-h3 { padding-left: 0.85rem; }
  .toc-h3 a { font-size: 0.75rem; color: var(--stone-300); }
  .toc-h3 a:hover { color: var(--stone-700); }
  .toc-h3 a.active { color: var(--ochre); }

  /* ── 본문 헤더 영역 ── */
  .doc-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
  }
  .doc-meta a { border: none; color: var(--stone-700); }
  .doc-meta a:hover { color: var(--ochre); }
  .doc-meta .dot { opacity: 0.5; }
  .doc-type { color: var(--ochre); }

  h1 {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    margin-bottom: 1rem;
  }
  .summary {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--stone-900);
    margin: 1rem 0 2rem;
    max-width: 640px;
  }

  .data-box {
    background: var(--paper-soft);
    border: 1px solid var(--rule);
    padding: 1.2rem 1.5rem;
    margin: 2rem 0;
    font-size: 0.9rem;
  }
  .data-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    gap: 1rem;
  }
  .data-row:last-child { border-bottom: none; }
  .data-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone-500);
    padding-top: 2px;
  }
  .mono { font-family: 'JetBrains Mono', monospace; }

  .related { margin-top: 4rem; }
  .related-list { list-style: none; padding: 0; margin: 1.5rem 0 0; }
  .related-list li { border-bottom: 1px solid var(--rule); }
  .related-list li:first-child { border-top: 1px solid var(--rule); }
  .related-list a {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 1rem;
    padding: 1rem 0;
    border: none;
    color: var(--ink);
    align-items: baseline;
    transition: background 0.15s;
  }
  .related-list a:hover { background: color-mix(in srgb, var(--ochre) 5%, transparent); color: var(--ink); }
  .related-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--stone-500);
  }
  .related-title { font-family: 'Spoqa Han Sans Neo', sans-serif; font-size: 1.1rem; }
  .related-weather {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--stone-500);
  }

  .diff-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    padding: 0.15em 0.55em;
    border: 1px solid;
    border-radius: 2px;
  }
  .diff-beginner   { color: var(--moss); border-color: color-mix(in srgb, var(--moss) 40%, transparent); }
  .diff-intermediate { color: var(--ochre); border-color: color-mix(in srgb, var(--ochre) 40%, transparent); }
  .diff-advanced   { color: var(--ink); border-color: var(--rule-strong); }

  .next-reads { margin-top: 4rem; }
  .next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-top: 1.5rem;
  }
  .next-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.2rem;
    background: var(--paper);
    border: none;
    color: var(--ink);
    transition: background 0.15s;
  }
  .next-card:hover { background: color-mix(in srgb, var(--ochre) 5%, var(--paper)); color: var(--ink); }
  .next-type {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ochre);
  }
  .next-title { font-family: 'Spoqa Han Sans Neo', sans-serif; font-size: 1.05rem; font-weight: 400; }
  .next-summary {
    font-size: 0.8rem;
    color: var(--stone-700);
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* ── 루트 테이블 ── */
  .route-table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .route-table th {
    text-align: left;
    padding: 0.7rem 0.5rem;
    border-bottom: 2px solid var(--ink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-500);
    font-weight: 500;
  }
  .route-table td { padding: 0.85rem 0.5rem; border-bottom: 1px solid var(--rule); vertical-align: middle; }
  .route-table tr:last-child td { border-bottom: none; }
  .route-table tr:hover td { background: color-mix(in srgb, var(--ochre) 3%, transparent); }
  .row-multi td { vertical-align: top; }
  .col-num  { width: 36px; color: var(--stone-500); }
  .col-grade { width: 80px; }
  .col-len  { width: 70px; color: var(--stone-700); }
  .col-style { width: 80px; }
  .route-name { font-family: 'Hahmlet', serif; font-size: 1rem; font-weight: 400; display: block; }
  .route-note { display: block; font-size: 0.78rem; color: var(--stone-700); margin-top: 0.15rem; }
  .pitch-inline { display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .pitch-pip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    padding: 0.15em 0.5em;
    background: var(--stone-100);
    color: var(--stone-700);
    border: 1px solid var(--rule);
  }
  .style-chip { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.06em; color: var(--stone-500); }

  /* ── 반응형 ── */
  @media (max-width: 860px) {
    .wiki-wrap--toc {
      grid-template-columns: 1fr;
      max-width: 760px;
    }
    .wiki-toc { display: none; }
  }
  @media (max-width: 640px) {
    .data-row { grid-template-columns: 1fr; gap: 0.2rem; padding: 0.6rem 0; }
    .related-list a { grid-template-columns: 1fr; gap: 0.3rem; padding: 0.8rem 0; }
    .next-grid { grid-template-columns: 1fr; }
    .col-len, .col-style { display: none; }
    .prose p { line-height: 1.85; font-size: 1.02rem; margin: 1.5rem 0; }
    .prose li { line-height: 1.85; margin: 0.5rem 0; }
    .prose h2 { font-size: 1.35rem; margin-top: 2.5rem; }
    .prose h3 { font-size: 1.1rem; margin-top: 1.75rem; }
    .prose blockquote { font-size: 1rem; line-height: 1.75; }
  }
</style>
</BaseLayout>
