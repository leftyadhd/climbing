---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const cragSlug = entry.slug.split('/').pop();
const allLogs = await getCollection('logs');

// 암장 루트 데이터 로드
const allCragRoutes = await getCollection('crag-routes');
const cragRoutesEntry = entry.data.type === 'crag'
  ? allCragRoutes.find(cr => cr.id === cragSlug) ?? null
  : null;

// 섹터별 그룹
const sectorNames: string[] = cragRoutesEntry
  ? [...new Set(cragRoutesEntry.data.routes.map(r => r.sector ?? '전체'))].sort()
  : [];
type CragRoute = typeof cragRoutesEntry extends null ? never : typeof cragRoutesEntry.data.routes[number];
const routesBySector: Record<string, CragRoute[]> = {};
if (cragRoutesEntry) {
  for (const r of cragRoutesEntry.data.routes) {
    const s = r.sector ?? '전체';
    if (!routesBySector[s]) routesBySector[s] = [];
    routesBySector[s].push(r);
  }
}

let relatedLogs: typeof allLogs = [];
if (entry.data.type === 'crag') {
  relatedLogs = allLogs.filter(l => l.data.crag === cragSlug);
} else if (entry.data.type === 'technique') {
  relatedLogs = allLogs.filter(l =>
    l.data.routes.some(r => r.techniques_used.includes(cragSlug!))
  );
}
relatedLogs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const typeLabel: Record<string, string> = {
  crag: '암장',
  technique: '기술',
  gear: '장비',
  guide: '가이드',
  route: '루트',
  term: '용어',
};
const diffLabel: Record<string, string> = {
  beginner: '입문',
  intermediate: '중급',
  advanced: '고급',
};

// 다음으로 읽을 것: 같은 타입의 다른 문서 (related_techniques 우선)
const allWikiForNext = await getCollection('wiki');
let nextReads = allWikiForNext
  .filter(w => w.slug !== entry.slug)
  .filter(w => {
    if (entry.data.type === 'technique' && entry.data.related_techniques.length > 0)
      return entry.data.related_techniques.some(rt => w.slug.endsWith(rt));
    return w.data.type === entry.data.type;
  })
  .slice(0, 3);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
<article data-pagefind-body>
<div class="container">

  <div class="doc-meta">
    <a href="/wiki/">← Wiki</a>
    <span class="dot">·</span>
    <span class="doc-type">{typeLabel[entry.data.type]}</span>
    {entry.data.type === 'technique' && entry.data.difficulty_level && (
      <>
        <span class="dot">·</span>
        <span class={`diff-badge diff-${entry.data.difficulty_level}`}>
          {diffLabel[entry.data.difficulty_level]}
        </span>
      </>
    )}
    {entry.data.updated && (
      <>
        <span class="dot">·</span>
        <span>Updated {entry.data.updated.toISOString().slice(0,10)}</span>
      </>
    )}
  </div>

  <h1>{entry.data.title}</h1>

  {entry.data.summary && (
    <p class="summary">{entry.data.summary}</p>
  )}

  <!-- crag 전용 데이터 박스 -->
  {entry.data.type === 'crag' && entry.data.location && (
    <div class="data-box">
      <div class="data-row">
        <span class="data-label">위치</span>
        <span>{entry.data.location.region} {entry.data.location.city && `— ${entry.data.location.city}`}</span>
      </div>
      <div class="data-row">
        <span class="data-label">좌표</span>
        <span class="mono">{entry.data.location.lat}°, {entry.data.location.lng}°</span>
      </div>
      {entry.data.rock_type && (
        <div class="data-row">
          <span class="data-label">암질</span>
          <span>{entry.data.rock_type}</span>
        </div>
      )}
      {entry.data.disciplines.length > 0 && (
        <div class="data-row">
          <span class="data-label">종류</span>
          <span>{entry.data.disciplines.join(' · ')}</span>
        </div>
      )}
      {entry.data.approach_minutes && (
        <div class="data-row">
          <span class="data-label">접근</span>
          <span>{entry.data.approach_minutes}분</span>
        </div>
      )}
      {entry.data.routes_count && (
        <div class="data-row">
          <span class="data-label">루트 수</span>
          <span>약 {entry.data.routes_count}개</span>
        </div>
      )}
      {entry.data.season_best.length > 0 && (
        <div class="data-row">
          <span class="data-label">시즌</span>
          <span>{entry.data.season_best.join(' · ')}</span>
        </div>
      )}
    </div>
  )}

  <!-- technique 전용 -->
  {entry.data.type === 'technique' && (
    <div class="data-box">
      {entry.data.difficulty_level && (
        <div class="data-row">
          <span class="data-label">난이도</span>
          <span>{entry.data.difficulty_level}</span>
        </div>
      )}
      {entry.data.common_on.length > 0 && (
        <div class="data-row">
          <span class="data-label">주 사용처</span>
          <span>{entry.data.common_on.join(' · ')}</span>
        </div>
      )}
    </div>
  )}

  <!-- gear 전용 -->
  {entry.data.type === 'gear' && (
    <div class="data-box">
      {entry.data.brand && (
        <div class="data-row">
          <span class="data-label">브랜드</span>
          <span>{entry.data.brand}</span>
        </div>
      )}
      {entry.data.gear_category && (
        <div class="data-row">
          <span class="data-label">분류</span>
          <span>{entry.data.gear_category}</span>
        </div>
      )}
      {entry.data.price_krw && (
        <div class="data-row">
          <span class="data-label">가격</span>
          <span class="mono">₩ {entry.data.price_krw.toLocaleString()}</span>
        </div>
      )}
    </div>
  )}

  {entry.data.tags.length > 0 && (
    <div class="tags">
      {entry.data.tags.map(t => <span class="tag">{t}</span>)}
    </div>
  )}

  <!-- 암장 루트 테이블 -->
  {cragRoutesEntry && (
    <section class="routes-section">
      <div class="eyebrow" style="margin-top:3rem;">Routes — 루트 목록</div>
      {sectorNames.map(sector => (
        <div class="sector-block">
          {sectorNames.length > 1 && (
            <div class="sector-label">{sector}</div>
          )}
          <table class="route-table">
            <thead>
              <tr>
                <th class="col-num">#</th>
                <th>이름</th>
                <th class="col-grade">난이도</th>
                <th class="col-len">길이</th>
                <th class="col-style">스타일</th>
              </tr>
            </thead>
            <tbody>
              {routesBySector[sector].map(r => (
                <tr class={r.pitches.length > 0 ? 'row-multi' : ''}>
                  <td class="col-num mono">{r.number ?? '—'}</td>
                  <td>
                    <span class="route-name">{r.name ?? '(미상)'}</span>
                    {r.notes && <span class="route-note">{r.notes}</span>}
                    {r.pitches.length > 0 && (
                      <div class="pitch-inline">
                        {r.pitches.map(p => (
                          <span class="pitch-pip">
                            P{p.number}{p.grade ? ` ${p.grade}` : ''}
                          </span>
                        ))}
                      </div>
                    )}
                  </td>
                  <td class="col-grade mono">{r.grade ?? '—'}</td>
                  <td class="col-len mono">{r.length_m ? `${r.length_m}m` : (r.pitches_count ? `${r.pitches_count}P` : '—')}</td>
                  <td class="col-style">
                    {r.style && <span class="style-chip">{r.style}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>
  )}

  <hr class="rule" />

  <div class="prose">
    <Content />
  </div>

  {relatedLogs.length > 0 && (
    <section class="related">
      <hr class="rule-ornate" />
      <div class="eyebrow">Connected — 관련 기록</div>
      <h2 style="margin-top:0.5rem;">이 {typeLabel[entry.data.type]}과 함께한 날들</h2>
      <ul class="related-list">
        {relatedLogs.map(log => (
          <li>
            <a href={`/logs/${log.slug}/`}>
              <span class="related-date">{log.data.date.toISOString().slice(0,10)}</span>
              <span class="related-title">{log.data.title}</span>
              {log.data.weather && <span class="related-weather">{log.data.weather}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {nextReads.length > 0 && (
    <section class="next-reads">
      <hr class="rule-ornate" />
      <div class="eyebrow">다음으로 읽을 것</div>
      <div class="next-grid">
        {nextReads.map(item => (
          <a href={`/wiki/${item.slug}/`} class="next-card">
            <span class="next-type">{typeLabel[item.data.type]}</span>
            <span class="next-title">{item.data.title}</span>
            {item.data.summary && <span class="next-summary">{item.data.summary}</span>}
          </a>
        ))}
      </div>
    </section>
  )}
</div>
</article>

<style>
  .doc-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
  }
  .doc-meta a { border: none; color: var(--stone-700); }
  .doc-meta a:hover { color: var(--ochre); }
  .doc-meta .dot { opacity: 0.5; }
  .doc-type { color: var(--ochre); }

  h1 {
    font-family: 'Fraunces', serif;
    margin-bottom: 1rem;
  }
  .summary {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.4;
    color: var(--stone-900);
    margin: 1rem 0 2rem;
    max-width: 640px;
  }

  .data-box {
    background: var(--paper-soft);
    border: 1px solid var(--rule);
    padding: 1.2rem 1.5rem;
    margin: 2rem 0;
    font-size: 0.9rem;
  }
  .data-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    gap: 1rem;
  }
  .data-row:last-child { border-bottom: none; }
  .data-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone-500);
    padding-top: 2px;
  }
  .mono { font-family: 'JetBrains Mono', monospace; }

  .related {
    margin-top: 4rem;
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .related-list li {
    border-bottom: 1px solid var(--rule);
  }
  .related-list li:first-child {
    border-top: 1px solid var(--rule);
  }
  .related-list a {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 1rem;
    padding: 1rem 0;
    border: none;
    color: var(--ink);
    align-items: baseline;
    transition: background 0.15s;
  }
  .related-list a:hover { background: color-mix(in srgb, var(--ochre) 5%, transparent); color: var(--ink); }
  .related-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--stone-500);
  }
  .related-title {
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
  }
  .related-weather {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--stone-500);
  }

  .diff-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    padding: 0.15em 0.55em;
    border: 1px solid;
    border-radius: 2px;
  }
  .diff-beginner   { color: var(--moss); border-color: color-mix(in srgb, var(--moss) 40%, transparent); }
  .diff-intermediate { color: var(--ochre); border-color: color-mix(in srgb, var(--ochre) 40%, transparent); }
  .diff-advanced   { color: var(--ink); border-color: var(--rule-strong); }

  .next-reads { margin-top: 4rem; }
  .next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-top: 1.5rem;
  }
  .next-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.2rem;
    background: var(--paper);
    border: none;
    color: var(--ink);
    transition: background 0.15s;
  }
  .next-card:hover { background: color-mix(in srgb, var(--ochre) 5%, var(--paper)); color: var(--ink); }
  .next-type {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ochre);
  }
  .next-title {
    font-family: 'Hahmlet', 'Fraunces', serif;
    font-size: 1.05rem;
    font-weight: 400;
  }
  .next-summary {
    font-size: 0.8rem;
    color: var(--stone-700);
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  /* 루트 테이블 */
  .routes-section { margin-bottom: 0; }
  .sector-block { margin-bottom: 2rem; }
  .sector-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-bottom: 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule);
  }
  .route-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .route-table th {
    text-align: left;
    padding: 0.7rem 0.5rem;
    border-bottom: 2px solid var(--ink);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-500);
    font-weight: 500;
  }
  .route-table td {
    padding: 0.85rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }
  .route-table tr:last-child td { border-bottom: none; }
  .route-table tr:hover td { background: color-mix(in srgb, var(--ochre) 3%, transparent); }
  .row-multi td { vertical-align: top; }
  .col-num  { width: 36px; color: var(--stone-500); }
  .col-grade { width: 80px; }
  .col-len  { width: 70px; color: var(--stone-700); }
  .col-style { width: 80px; }
  .route-name {
    font-family: 'Hahmlet', serif;
    font-size: 1rem;
    font-weight: 400;
    display: block;
  }
  .route-note {
    display: block;
    font-size: 0.78rem;
    color: var(--stone-700);
    margin-top: 0.15rem;
  }
  .pitch-inline {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }
  .pitch-pip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    padding: 0.15em 0.5em;
    background: var(--stone-100);
    color: var(--stone-700);
    border: 1px solid var(--rule);
  }
  .style-chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--stone-500);
  }

  @media (max-width: 640px) {
    .data-row { grid-template-columns: 1fr; gap: 0.2rem; padding: 0.6rem 0; }
    .related-list a { grid-template-columns: 1fr; gap: 0.3rem; padding: 0.8rem 0; }
    .next-grid { grid-template-columns: 1fr; }
    .col-len, .col-style { display: none; }
  }
</style>
</BaseLayout>
