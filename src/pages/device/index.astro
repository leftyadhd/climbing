---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const all = await getCollection('devices');
const active = all.filter(d => d.data.active !== false).sort((a, b) =>
  (a.data.category || '').localeCompare(b.data.category || '', 'ko')
);
const retired = all.filter(d => d.data.active === false);

const categories = [...new Set(active.map(d => d.data.category))].sort((a, b) =>
  a.localeCompare(b, 'ko')
);

const conditionLabel: Record<string, string> = {
  new:     '새것',
  good:    '양호',
  fair:    '보통',
  retired: '퇴역',
};
const conditionClass: Record<string, string> = {
  new:     'cond-new',
  good:    'cond-good',
  fair:    'cond-fair',
  retired: 'cond-retired',
};
---
<BaseLayout title="장비">
<div class="container">

  <div class="eyebrow">Device — 장비 인벤토리</div>
  <h1>내 장비의 <em>목록.</em></h1>
  <p class="intro">소유한 장비를 카테고리별로 관리합니다.</p>

  <div class="summary-strip">
    <div class="sum-item">
      <span class="sum-n">{active.length}</span>
      <span class="sum-l">현역 장비</span>
    </div>
    <div class="sum-item">
      <span class="sum-n">{categories.length}</span>
      <span class="sum-l">카테고리</span>
    </div>
    {retired.length > 0 && (
      <div class="sum-item">
        <span class="sum-n">{retired.length}</span>
        <span class="sum-l">퇴역</span>
      </div>
    )}
  </div>

  <hr class="rule" />

  {categories.map(cat => {
    const items = active.filter(d => d.data.category === cat);
    return (
      <section class="cat-section">
        <div class="cat-head">
          <h2>{cat}</h2>
          <span class="cat-count">{String(items.length).padStart(2,'0')}</span>
        </div>
        <ul class="device-list">
          {items.map(d => (
            <li class="device-row">
              <div class="device-main">
                <span class="device-title">{d.data.title}</span>
                {d.data.brand && <span class="device-brand">{d.data.brand}{d.data.model ? ` · ${d.data.model}` : ''}</span>}
              </div>
              <div class="device-meta">
                {d.data.purchased && (
                  <span class="device-date">{d.data.purchased.toISOString().slice(0,10)}</span>
                )}
                {d.data.price_krw && (
                  <span class="device-price">₩{d.data.price_krw.toLocaleString()}</span>
                )}
                <span class={`cond-badge ${conditionClass[d.data.condition]}`}>
                  {conditionLabel[d.data.condition]}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </section>
    );
  })}

  {retired.length > 0 && (
    <section class="cat-section retired-section">
      <div class="cat-head">
        <h2>퇴역</h2>
        <span class="cat-count">{String(retired.length).padStart(2,'0')}</span>
      </div>
      <ul class="device-list">
        {retired.map(d => (
          <li class="device-row device-row--retired">
            <div class="device-main">
              <span class="device-title">{d.data.title}</span>
              {d.data.brand && <span class="device-brand">{d.data.brand}</span>}
            </div>
            <div class="device-meta">
              <span class={`cond-badge ${conditionClass[d.data.condition]}`}>
                {conditionLabel[d.data.condition]}
              </span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

</div>

<style>
  h1 {
    font-family: 'Fraunces', 'Hahmlet', serif;
    font-weight: 400;
    line-height: 1.05;
    margin-bottom: 1rem;
  }
  h1 em { font-style: italic; color: var(--ochre); }
  .intro { font-size: 1.05rem; color: var(--stone-700); margin-bottom: 2rem; }

  .summary-strip {
    display: flex;
    gap: 2.5rem;
    margin-bottom: 2rem;
  }
  .sum-item { display: flex; flex-direction: column; }
  .sum-n {
    font-family: 'Fraunces', serif;
    font-size: 2.2rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .sum-l {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-top: 0.3rem;
  }

  .cat-section { margin-top: 3rem; }
  .cat-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.8rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 0;
  }
  .cat-head h2 { margin: 0; font-size: 1.4rem; }
  .cat-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--stone-500);
    letter-spacing: 0.1em;
  }

  .device-list { list-style: none; margin: 0; padding: 0; }
  .device-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    transition: background 0.15s;
  }
  .device-row:last-child { border-bottom: none; }
  .device-row:hover { background: color-mix(in srgb, var(--ochre) 3%, transparent); }
  .device-row--retired { opacity: 0.5; }

  .device-main { display: flex; align-items: baseline; gap: 0.8rem; min-width: 0; }
  .device-title {
    font-family: 'Hahmlet', 'Fraunces', serif;
    font-size: 1.1rem;
    font-weight: 400;
    flex-shrink: 0;
  }
  .device-brand {
    font-size: 0.85rem;
    color: var(--stone-500);
  }

  .device-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-shrink: 0;
  }
  .device-date, .device-price {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--stone-500);
    letter-spacing: 0.03em;
  }

  .cond-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    padding: 0.2em 0.6em;
    border: 1px solid;
    border-radius: 2px;
  }
  .cond-new     { color: var(--moss); border-color: color-mix(in srgb, var(--moss) 40%, transparent); }
  .cond-good    { color: var(--stone-700); border-color: var(--rule-strong); }
  .cond-fair    { color: var(--ochre); border-color: color-mix(in srgb, var(--ochre) 40%, transparent); }
  .cond-retired { color: var(--stone-500); border-color: var(--rule); }

  .retired-section { opacity: 0.7; }

  @media (max-width: 640px) {
    .device-row { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
    .device-meta { flex-wrap: wrap; }
  }
</style>
</BaseLayout>
