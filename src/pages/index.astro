---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allLogs = (await getCollection('logs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recentLogs = allLogs.slice(0, 5);

const crags = await getCollection('crags');
const allWiki = await getCollection('wiki');

const sendsCount = allLogs.reduce((sum, log) =>
  sum + log.data.routes.filter(r => ['onsight','flash','redpoint','send'].includes(r.status)).length, 0);

const totalRoutes = allLogs.reduce((s, l) => s + l.data.routes.length, 0);

const allPartners = new Set(allLogs.flatMap(l => [...l.data.partners, ...l.data.crew]).filter(Boolean));

const now = new Date();
const monthlyData = Array.from({ length: 6 }, (_, i) => {
  const d = new Date(now.getFullYear(), now.getMonth() - (5 - i), 1);
  const count = allLogs.filter(l => {
    const ld = l.data.date;
    return ld.getFullYear() === d.getFullYear() && ld.getMonth() === d.getMonth();
  }).length;
  return { label: `${d.getMonth() + 1}월`, count };
});
const maxMonth = Math.max(...monthlyData.map(m => m.count), 1);

const projects = allLogs.flatMap(l =>
  l.data.routes
    .filter(r => r.status === 'projecting')
    .map(r => ({ name: r.name ?? r.route_ref, grade: r.grade, logSlug: l.slug, crag: l.data.crag }))
).filter(p => p.name).slice(0, 4);

// NFC-safe crag log count
const cragLogCount = new Map<string, number>();
for (const log of allLogs) {
  if (log.data.crag) {
    const key = log.data.crag.normalize('NFC');
    cragLogCount.set(key, (cragLogCount.get(key) ?? 0) + 1);
  }
}
const topCrags = crags
  .map(c => {
    const key = (c.slug ?? c.id.replace(/\.md$/,'').split('/').pop()!).normalize('NFC');
    return { crag: c, slug: c.slug ?? c.id.replace(/\.md$/,'').split('/').pop()!, visits: cragLogCount.get(key) ?? 0 };
  })
  .sort((a, b) => b.visits - a.visits)
  .slice(0, 3);
---
<BaseLayout title="홈">
<div class="home">

  <!-- ══════════════════════════════════════ HERO ══ -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-silhouette"></div>
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-inner">
      <div class="hero-coord mono">N 35.493° · E 126.573° · 2026</div>
      <h1 class="hero-h1">
        돌과 함께<br/>
        <em>오르는 하루.</em>
      </h1>
      <p class="hero-sub">암벽등반을 공부하고, 기록하고, 다시 찾는 곳.</p>
      <div class="hero-actions">
        <a href="/logs/" class="hbtn hbtn-fill">Logs →</a>
        <a href="/crags/" class="hbtn hbtn-ghost">Crags →</a>
        <a href="/stats/" class="hbtn hbtn-ghost">Stats →</a>
      </div>
    </div>
    <div class="hero-scroll-hint mono">scroll</div>
  </section>

  <!-- ════════════════════════════════ VOID STATS ══ -->
  <section class="void-stats">
    <div class="void-inner">
      <div class="vstat">
        <div class="vn">{allLogs.length}</div>
        <div class="vl mono">Sessions</div>
      </div>
      <div class="vdiv"></div>
      <div class="vstat">
        <div class="vn">{sendsCount}</div>
        <div class="vl mono">Sends</div>
      </div>
      <div class="vdiv"></div>
      <div class="vstat">
        <div class="vn">{crags.length}</div>
        <div class="vl mono">Crags</div>
      </div>
      <div class="vdiv"></div>
      <div class="vstat">
        <div class="vn">{allPartners.size}</div>
        <div class="vl mono">Partners</div>
      </div>
      <div class="vdiv vdiv-hide"></div>
      <div class="vstat vstat-spark">
        <div class="sparkline">
          {monthlyData.map((m, i) => (
            <div class="spark-col" title={`${m.label} · ${m.count}회`}>
              <div
                class={`spark-bar${i === monthlyData.length - 1 ? ' spark-last' : ''}`}
                style={`height: ${Math.max(Math.round((m.count / maxMonth) * 100), m.count > 0 ? 8 : 3)}%`}
              ></div>
              <div class="spark-label mono">{m.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ RECENT LOGS ══ -->
  <section class="content-section">
    <div class="section-inner">
      <div class="section-hd">
        <span class="eyebrow">Field Notes — 최근 기록</span>
        <a href="/logs/" class="see-all mono">전체 로그 →</a>
      </div>
      <div class="log-list">
        {recentLogs.map(log => {
          const d = log.data.date;
          const sv = log.data.routes.filter(r => ['onsight','flash','redpoint','send'].includes(r.status)).length;
          const pv = log.data.routes.filter(r => ['projecting','attempt'].includes(r.status)).length;
          return (
            <a href={`/logs/${log.slug}/`} class="lentry">
              <div class="ldate">
                <span class="lday mono">{String(d.getDate()).padStart(2,'0')}</span>
                <span class="lym mono">{d.getFullYear()}.{String(d.getMonth()+1).padStart(2,'0')}</span>
              </div>
              <div class="lbody">
                <div class="ltitle">{log.data.title}</div>
                <div class="lmeta mono">
                  {log.data.crag && <span>{log.data.crag}</span>}
                  {log.data.weather && <span>{log.data.weather}</span>}
                  {log.data.routes.length > 0 && <span>{log.data.routes.length}R</span>}
                </div>
              </div>
              <div class="lresult">
                {sv > 0 && <span class="lsend">{sv}<small>S</small></span>}
                {pv > 0 && sv === 0 && <span class="lproject">{pv}<small>P</small></span>}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ══════════════════════════ CURRENT PROJECTS ══ */}
  {projects.length > 0 && (
    <section class="content-section projects-section">
      <div class="section-inner">
        <div class="section-hd">
          <span class="eyebrow">On The Wall — 진행 중인 루트</span>
          <a href="/logs/" class="see-all mono">전체 로그 →</a>
        </div>
        <div class="proj-grid">
          {projects.map(p => (
            <a href={`/logs/${p.logSlug}/`} class="pcard">
              <div class="pcard-status mono">PROJECTING</div>
              <div class="pcard-name">{p.name}</div>
              {p.grade && <div class="pcard-grade mono">{p.grade}</div>}
              {p.crag && <div class="pcard-crag mono">{p.crag}</div>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ════════════════════════════ TOP CRAGS ══ -->
  {topCrags.length > 0 && (
    <section class="content-section">
      <div class="section-inner">
        <div class="section-hd">
          <span class="eyebrow">Crags — 자주 찾는 암장</span>
          <a href="/crags/" class="see-all mono">전체 암장 →</a>
        </div>
        <div class="crag-trio">
          {topCrags.map(({ crag, slug, visits }) => (
            <a href={`/crags/${slug}/`} class="ctile">
              {visits > 0 && <div class="ctile-visits mono">{visits}회</div>}
              <div class="ctile-title">{crag.data.title}</div>
              {crag.data.summary && <div class="ctile-summary">{crag.data.summary}</div>}
              <div class="ctile-foot mono">
                {crag.data.disciplines.slice(0,2).map(d => <span>{d}</span>)}
                {crag.data.routes.length > 0 && <span>{crag.data.routes.length}R</span>}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════════════════════ WIKI TEASER ══ -->
  <section class="void-wiki">
    <div class="wiki-inner">
      <div class="wiki-hd">
        <div class="wiki-eyebrow mono">Wiki — 배움의 서가</div>
        <div class="wiki-hdline">알아두어야 할 것들</div>
        <a href="/wiki/" class="see-all mono" style="color: rgba(240,240,240,0.4)">전체 위키 →</a>
      </div>
      <div class="wiki-trio">
        <a href="/wiki/" class="wtile">
          <div class="wtile-num mono">01</div>
          <div class="wtile-name">기술 · 무브</div>
          <div class="wtile-desc">힐훅, 드롭니, 다이노 — 몸을 바위 위에서 움직이는 법.</div>
        </a>
        <a href="/wiki/" class="wtile">
          <div class="wtile-num mono">02</div>
          <div class="wtile-name">장비</div>
          <div class="wtile-desc">확보기, 하네스, 로프 — 생명줄이 되는 물건들의 기록.</div>
        </a>
        <a href="/wiki/" class="wtile">
          <div class="wtile-num mono">03</div>
          <div class="wtile-name">시스템 · 안전</div>
          <div class="wtile-desc">확보 시스템, 하강 방법, 셀프레스큐.</div>
        </a>
        <a href="/wiki/" class="wtile">
          <div class="wtile-num mono">04</div>
          <div class="wtile-name">전체 문서</div>
          <div class="wtile-desc">{allWiki.length}개 문서 — 지식은 계속 쌓인다.</div>
        </a>
      </div>
    </div>
  </section>

</div>

<style>
  .home { min-height: 100vh; }
  .mono { font-family: 'JetBrains Mono', monospace; }

  /* ── HERO ── */
  .hero {
    position: relative;
    height: calc(100svh - 57px);
    min-height: 560px;
    max-height: 900px;
    overflow: hidden;
  }
  .hero-bg { position: absolute; inset: 0; }
  .hero-silhouette {
    width: 100%; height: 100%;
    background-image:
      radial-gradient(ellipse at 28% 45%, rgba(0, 232, 122, 0.04) 0%, transparent 55%),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 1200 700' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolygon points='0,700 180,260 360,390 520,170 700,290 880,130 1050,210 1200,150 1200,700' fill='%23111111' opacity='0.9'/%3E%3Cpolygon points='0,700 120,440 280,470 440,390 620,430 780,360 960,400 1100,340 1200,370 1200,700' fill='%23080808' opacity='0.95'/%3E%3C/svg%3E"),
      linear-gradient(180deg, #000000 0%, #0a0a0a 100%);
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 20%, rgba(0,0,0,0.85) 100%);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #f0f0f0;
  }
  .hero-coord {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240,240,240,0.3);
    margin-bottom: 2.5rem;
  }
  .hero-h1 {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: clamp(3.2rem, 9vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: 1.8rem;
    color: #f0f0f0;
  }
  .hero-h1 em {
    
    font-weight: 300;
    color: #00e87a;
  }
  .hero-sub {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    max-width: 460px;
    color: rgba(240,240,240,0.55);
    line-height: 1.6;
    margin-bottom: 3rem;
  }
  .hero-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .hbtn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.65em 1.4em;
    border: 1px solid;
    transition: background 0.15s, color 0.15s;
  }
  .hbtn-fill {
    background: #00e87a;
    color: #000;
    border-color: #00e87a;
  }
  .hbtn-fill:hover { background: #00ff88; border-color: #00ff88; color: #000; }
  .hbtn-ghost {
    background: transparent;
    color: rgba(240,240,240,0.5);
    border-color: rgba(240,240,240,0.18);
  }
  .hbtn-ghost:hover { color: #f0f0f0; border-color: rgba(240,240,240,0.5); }
  .hbtn { border-bottom-width: 1px; } /* override global a */

  .hero-scroll-hint {
    position: absolute;
    bottom: 1.8rem;
    right: 2.5rem;
    z-index: 2;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(240,240,240,0.18);
    writing-mode: vertical-rl;
  }

  /* ── VOID STATS ── */
  .void-stats {
    background: var(--void);
    border-bottom: 1px solid rgba(237,232,216,0.06);
  }
  .void-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
    display: flex;
    align-items: stretch;
    gap: 0;
    min-height: 140px;
  }
  .vdiv {
    width: 1px;
    background: rgba(237,232,216,0.07);
    align-self: stretch;
  }
  .vdiv-hide { display: none; }
  .vstat {
    flex: 1;
    padding: 2.2rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .vn {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1;
    color: #f0f0f0;
    font-variant-numeric: tabular-nums;
  }
  .vl {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(240,240,240,0.3);
    margin-top: 0.4rem;
  }
  .vstat-spark { flex: 1.4; }
  .sparkline {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 56px;
    width: 100%;
  }
  .spark-col {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
  }
  .spark-bar {
    width: 100%;
    min-height: 3px;
    background: rgba(255,255,255,0.1);
    border-radius: 1px;
  }
  .spark-last { background: #00e87a; }
  .spark-label {
    font-size: 0.55rem;
    letter-spacing: 0.04em;
    color: rgba(240,240,240,0.2);
    white-space: nowrap;
  }

  /* ── CONTENT SECTIONS ── */
  .content-section { padding: 4rem 2.5rem; }
  .content-section + .content-section { padding-top: 0; }
  .section-inner { max-width: 1200px; margin: 0 auto; }
  .section-hd {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    gap: 1rem;
  }
  .eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone-500);
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .eyebrow::before {
    content: '';
    display: inline-block;
    width: 16px; height: 1px;
    background: var(--ochre);
  }
  .see-all {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone-500);
    border-bottom: 1px solid var(--rule-strong) !important;
    white-space: nowrap;
  }
  .see-all:hover { color: var(--ochre) !important; border-bottom-color: var(--ochre) !important; }

  /* ── LOG LIST ── */
  .log-list { display: flex; flex-direction: column; }
  .lentry {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 1.4rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    border-left: none; border-right: none;
    transition: background 0.1s, padding-left 0.1s;
  }
  .log-list .lentry:first-child { border-top: 1px solid var(--rule); }
  .lentry:hover { background: color-mix(in srgb, var(--ochre) 4%, transparent); padding-left: 0.5rem; color: var(--ink); border-bottom-color: var(--rule); }
  .ldate { text-align: right; flex-shrink: 0; }
  .lday { display: block; font-size: 1.05rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1; }
  .lym  { display: block; font-size: 0.55rem; color: var(--stone-500); margin-top: 0.15rem; letter-spacing: 0.04em; }
  .ltitle {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .lmeta {
    font-size: 0.65rem;
    color: var(--stone-500);
    display: flex;
    gap: 0.6em;
    flex-wrap: wrap;
    margin-top: 0.18rem;
    letter-spacing: 0.03em;
  }
  .lmeta span + span::before { content: '·'; margin-right: 0.6em; }
  .lsend {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--moss);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    letter-spacing: -0.04em;
    line-height: 1;
    gap: 0.05rem;
  }
  .lproject {
    font-family: 'Spoqa Han Sans Neo', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--ochre) 70%, transparent);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    letter-spacing: -0.04em;
    line-height: 1;
    gap: 0.05rem;
  }
  .lsend small, .lproject small {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.14em;
    opacity: 0.55;
  }

  /* ── PROJECTS ── */
  .projects-section { border-top: 1px solid var(--rule); }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1px;
    background: var(--rule-strong);
    border: 1px solid var(--rule-strong);
  }
  .pcard {
    background: var(--paper-card);
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    color: var(--ink);
    border: none;
    min-height: 110px;
    transition: background 0.12s;
  }
  .pcard:hover { background: color-mix(in srgb, var(--ochre) 5%, var(--paper-card)); color: var(--ink); border-bottom: none; }
  .pcard-status { font-size: 0.58rem; letter-spacing: 0.18em; color: var(--ochre); text-transform: uppercase; }
  .pcard-name { font-family: 'Spoqa Han Sans Neo', sans-serif; font-size: 1.05rem; letter-spacing: -0.02em; margin-top: 0.3rem; }
  .pcard-grade { font-size: 0.7rem; color: var(--stone-500); }
  .pcard-crag { font-size: 0.62rem; color: var(--stone-500); margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--rule); }

  /* ── CRAG TRIO ── */
  .crag-trio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule-strong);
    border: 1px solid var(--rule-strong);
  }
  .ctile {
    background: var(--paper-card);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--ink);
    border: none;
    position: relative;
    transition: background 0.12s;
    min-height: 130px;
  }
  .ctile:hover { background: color-mix(in srgb, var(--ochre) 4%, var(--paper-card)); color: var(--ink); border-bottom: none; }
  .ctile-visits {
    position: absolute; top: 1rem; right: 1rem;
    font-size: 0.58rem; letter-spacing: 0.1em;
    color: var(--ochre);
    background: color-mix(in srgb, var(--ochre) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--ochre) 22%, transparent);
    padding: 0.12em 0.4em;
  }
  .ctile-title { font-family: 'Spoqa Han Sans Neo', sans-serif; font-size: 1.05rem; letter-spacing: -0.02em; margin-right: 2.5rem; }
  .ctile-summary { font-size: 0.78rem; color: var(--stone-700); line-height: 1.4; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ctile-foot {
    display: flex; gap: 0.6rem; flex-wrap: wrap;
    font-size: 0.6rem; color: var(--stone-500);
    letter-spacing: 0.06em; text-transform: uppercase;
    border-top: 1px solid var(--rule); padding-top: 0.6rem;
    margin-top: auto;
  }
  .ctile-foot span + span::before { content: '·'; margin-right: 0.6em; }

  /* ── VOID WIKI ── */
  .void-wiki {
    background: var(--void);
    margin-top: 4rem;
    padding: 5rem 2.5rem;
    color: #ede8d8;
  }
  .wiki-inner { max-width: 1200px; margin: 0 auto; }
  .wiki-hd {
    display: flex;
    align-items: baseline;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .wiki-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240,240,240,0.3);
    display: flex; align-items: center; gap: 0.6em;
  }
  .wiki-eyebrow::before { content: ''; width: 16px; height: 1px; background: #00e87a; display: inline-block; }
