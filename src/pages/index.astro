---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allLogs = (await getCollection('logs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const logs = allLogs.slice(0, 4);

const crags = await getCollection('wiki', ({ data }) => data.type === 'crag');
const techniques = await getCollection('wiki', ({ data }) => data.type === 'technique');
const gear = await getCollection('wiki', ({ data }) => data.type === 'gear');
const allWiki = await getCollection('wiki');

const sendsCount = allLogs.reduce((sum, log) =>
  sum + log.data.routes.filter(r => ['onsight','flash','redpoint','send'].includes(r.status)).length, 0);

// 최근 6개월 세션 분포 (스파크라인)
const now = new Date();
const monthlyData = Array.from({ length: 6 }, (_, i) => {
  const d = new Date(now.getFullYear(), now.getMonth() - (5 - i), 1);
  const count = allLogs.filter(l => {
    const ld = l.data.date;
    return ld.getFullYear() === d.getFullYear() && ld.getMonth() === d.getMonth();
  }).length;
  return { label: `${d.getMonth() + 1}월`, count };
});
const maxMonth = Math.max(...monthlyData.map(m => m.count), 1);

// 진행 중인 프로젝트 루트
const projects = allLogs.flatMap(l =>
  l.data.routes
    .filter(r => r.status === 'projecting')
    .map(r => ({ name: r.name, grade: r.grade, logSlug: l.slug, logTitle: l.data.title, crag: l.data.crag }))
).slice(0, 3);
---
<BaseLayout title="홈" hero={true}>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg">
    <!-- 실제 사진으로 교체하세요. /public/hero.jpg 파일 추가 후 url 변경 -->
    <div class="hero-placeholder"></div>
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-meta">
      <span>N 35.493°</span>
      <span class="dot">·</span>
      <span>E 126.573°</span>
      <span class="dot">·</span>
      <span>Est. 2026</span>
    </div>
    <h1 class="hero-title">
      돌과 함께<br/>
      <em>오르는 하루.</em>
    </h1>
    <p class="hero-tag">
      암벽등반을 공부하고, 기록하고, 다시 찾는 곳.
    </p>
    <div class="hero-cta">
      <a href="/wiki/" class="cta">Wiki 탐색 →</a>
      <a href="/logs/" class="cta cta-outline">최근 등반 →</a>
    </div>
  </div>
  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- STATS STRIP -->
<section class="stats">
  <div class="container-wide">
    <div class="stats-grid">
      <div class="stat">
        <div class="stat-num">{allLogs.length.toString().padStart(2, '0')}</div>
        <div class="stat-label">세션 기록</div>
        <div class="sparkline">
          {monthlyData.map(m => (
            <div class="spark-bar-wrap" title={`${m.label} ${m.count}세션`}>
              <div class="spark-bar" style={`height:${Math.round((m.count / maxMonth) * 100)}%`}></div>
            </div>
          ))}
        </div>
      </div>
      <div class="stat">
        <div class="stat-num">{sendsCount.toString().padStart(2, '0')}</div>
        <div class="stat-label">완등 루트</div>
      </div>
      <div class="stat">
        <div class="stat-num">{crags.length.toString().padStart(2, '0')}</div>
        <div class="stat-label">암장 아카이브</div>
      </div>
      <div class="stat">
        <div class="stat-num">{allWiki.length.toString().padStart(2, '0')}</div>
        <div class="stat-label">위키 문서</div>
      </div>
    </div>
  </div>
</section>

<!-- RECENT LOGS -->
<section class="container-wide section">
  <div class="section-head">
    <div>
      <div class="eyebrow">Field Notes — 최근 기록</div>
      <h2>돌 위에서의 하루들</h2>
    </div>
    <a href="/logs/" class="view-all">전체 로그 →</a>
  </div>

  <div class="logs-grid">
    {logs.map((log, i) => (
      <article class="log-card">
        <div class="log-num">{String(i + 1).padStart(2, '0')}</div>
        <div class="log-body">
          <div class="meta">
            {log.data.date.toISOString().slice(0, 10)}
            {log.data.crag && ` · ${log.data.crag}`}
            {log.data.weather && ` · ${log.data.weather}`}
          </div>
          <h3 class="log-title">
            <a href={`/logs/${log.slug}/`}>{log.data.title}</a>
          </h3>
          {log.data.routes.length > 0 && (
            <p class="log-routes">
              루트 {log.data.routes.length}개 —{' '}
              {log.data.routes.slice(0, 3).map(r => r.name).join(', ')}
              {log.data.routes.length > 3 && ' 외'}
            </p>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

{projects.length > 0 && (
  <>
    <hr class="rule-ornate" style="z-index:2; position:relative;" />
    <section class="container-wide section">
      <div class="section-head">
        <div>
          <div class="eyebrow">On the Wall — 진행 중</div>
          <h2>아직 잡지 못한 루트들</h2>
        </div>
        <a href="/logs/" class="view-all">전체 로그 →</a>
      </div>
      <div class="projects-grid">
        {projects.map(p => (
          <a href={`/logs/${p.logSlug}/`} class="project-card">
            <div class="project-status">PROJECTING</div>
            <div class="project-name">{p.name}</div>
            {p.grade && <div class="project-grade">{p.grade}</div>}
            <div class="project-log">{p.logTitle}</div>
          </a>
        ))}
      </div>
    </section>
  </>
)}

<hr class="rule-ornate" style="z-index:2; position:relative;" />

<!-- WIKI TEASER -->
<section class="container-wide section">
  <div class="section-head">
    <div>
      <div class="eyebrow">Wiki — 배움의 서가</div>
      <h2>알아두어야 할 것들</h2>
    </div>
    <a href="/wiki/" class="view-all">전체 위키 →</a>
  </div>

  <div class="wiki-grid">
    <a href="/wiki/" class="wiki-card">
      <div class="wiki-num">I</div>
      <h3>기술 · 무브</h3>
      <p>힐훅, 드롭니, 다이노 — 몸을 바위 위에서 움직이는 법.</p>
      <div class="wiki-count">{techniques.length}개 문서</div>
    </a>
    <a href="/wiki/" class="wiki-card">
      <div class="wiki-num">II</div>
      <h3>장비</h3>
      <p>확보기, 하네스, 로프 — 생명줄이 되는 물건들의 기록.</p>
      <div class="wiki-count">{gear.length}개 문서</div>
    </a>
    <a href="/wiki/" class="wiki-card">
      <div class="wiki-num">III</div>
      <h3>암장 · 크랙</h3>
      <p>전국과 해외의 바위들. 접근법과 루트 정보.</p>
      <div class="wiki-count">{crags.length}개 문서</div>
    </a>
  </div>
</section>

<style>
  /* HERO */
  .hero {
    position: relative;
    height: calc(100vh - 80px);
    min-height: 580px;
    max-height: 820px;
    overflow: hidden;
    margin: -1px 0 0 0;
    z-index: 2;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .hero-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #1a1815 0%, #3a3731 40%, #5c5850 100%);
    background-image:
      radial-gradient(ellipse at 30% 40%, rgba(168, 90, 42, 0.25) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(74, 93, 58, 0.3) 0%, transparent 60%),
      url("data:image/svg+xml,%3Csvg viewBox='0 0 800 600' xmlns='http://www.w3.org/2000/svg'%3E%3Cpolygon points='0,600 200,250 400,380 550,180 700,300 800,220 800,600' fill='%23000' opacity='0.4'/%3E%3Cpolygon points='0,600 150,400 350,460 500,350 680,420 800,380 800,600' fill='%23000' opacity='0.5'/%3E%3Cpolygon points='0,600 100,520 280,540 450,490 600,510 800,480 800,600' fill='%23000' opacity='0.6'/%3E%3C/svg%3E");
    background-size: cover;
    background-position: center;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(26, 24, 21, 0.3) 0%,
      rgba(26, 24, 21, 0.1) 40%,
      rgba(26, 24, 21, 0.7) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 3;
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #f4efe1;
  }
  .hero-meta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 2rem;
    display: flex;
    gap: 0.8em;
    align-items: center;
  }
  .hero-meta .dot { opacity: 0.5; }
  .hero-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    max-width: 900px;
  }
  .hero-title em {
    font-style: italic;
    color: #d48a5a;
    font-weight: 300;
  }
  .hero-tag {
    font-size: 1.15rem;
    max-width: 480px;
    opacity: 0.85;
    margin-bottom: 3rem;
    line-height: 1.5;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cta {
    display: inline-block;
    padding: 0.9rem 1.6rem;
    background: #f4efe1;
    color: #1a1815;
    border: 1px solid #f4efe1;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.2s;
  }
  .cta:hover {
    background: #d48a5a;
    border-color: #d48a5a;
    color: #1a1815;
  }
  .cta-outline {
    background: transparent;
    color: #f4efe1;
    border-color: rgba(244, 239, 225, 0.4);
  }
  .cta-outline:hover {
    background: rgba(244, 239, 225, 0.1);
    border-color: #f4efe1;
    color: #f4efe1;
  }
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    z-index: 3;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 239, 225, 0.6);
    display: flex;
    align-items: center;
    gap: 0.8em;
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: rgba(244, 239, 225, 0.4);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; transform: scaleY(0.6); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  /* STATS */
  .stats {
    background: var(--paper-soft);
    border-bottom: 1px solid var(--rule);
    position: relative;
    z-index: 2;
    padding: 2.5rem 0;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .stat { text-align: left; padding: 0 1rem; border-left: 1px solid var(--rule); }
  .stat:first-child { border-left: none; padding-left: 0; }
  .stat-num {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--stone-500);
    margin-top: 0.5rem;
  }
  .sparkline {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 28px;
    margin-top: 0.8rem;
  }
  .spark-bar-wrap {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
  }
  .spark-bar {
    width: 100%;
    min-height: 2px;
    background: var(--ochre);
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .spark-bar-wrap:last-child .spark-bar { opacity: 1; }

  /* PROJECTS */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem;
    background: var(--paper);
    border: none;
    color: var(--ink);
    transition: background 0.15s;
  }
  .project-card:hover { background: color-mix(in srgb, var(--ochre) 5%, var(--paper)); }
  .project-status {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--ochre);
    margin-bottom: 0.2rem;
  }
  .project-name {
    font-family: 'Fraunces', 'Hahmlet', serif;
    font-size: 1.3rem;
    font-weight: 400;
  }
  .project-grade {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--stone-700);
  }
  .project-log {
    font-size: 0.82rem;
    color: var(--stone-500);
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* SECTION */
  .section { margin-top: 2rem; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .section-head h2 { margin: 0; }
  .view-all {
    border: none;
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--stone-700);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .view-all:hover { color: var(--ochre); border-bottom-color: var(--ochre); }

  /* LOGS */
  .logs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .log-card {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
    transition: background 0.2s;
  }
  .log-card:hover { background: color-mix(in srgb, var(--ochre) 4%, transparent); }
  .log-card:first-child { border-top: 1px solid var(--rule); }
  .log-num {
    font-family: 'Fraunces', serif;
    font-size: 2.5rem;
    font-weight: 400;
    color: var(--stone-500);
    font-variant-numeric: oldstyle-nums;
  }
  .log-title {
    font-family: 'Fraunces', serif;
    font-size: 1.6rem;
    margin: 0.3rem 0;
  }
  .log-title a { border: none; color: var(--ink); }
  .log-title a:hover { color: var(--ochre); }
  .log-routes {
    color: var(--stone-700);
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  /* WIKI CARDS */
  .wiki-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .wiki-card {
    padding: 2.5rem 2rem;
    border-left: 1px solid var(--rule);
    border: 1px solid var(--rule);
    border-top: none;
    border-bottom: none;
    border-right: none;
    transition: background 0.2s;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .wiki-card:first-child { border-left: none; }
  .wiki-card:hover { background: color-mix(in srgb, var(--ochre) 5%, transparent); }
  .wiki-num {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--ochre);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .wiki-card h3 {
    font-size: 1.5rem;
    margin: 0;
  }
  .wiki-card p {
    color: var(--stone-700);
    font-size: 0.95rem;
    margin: 0.5rem 0;
  }
  .wiki-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--stone-500);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: auto;
    padding-top: 1rem;
  }

  @media (max-width: 820px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
    .stat { border-left: none; padding: 0; }
    .wiki-grid { grid-template-columns: 1fr; }
    .wiki-card { border-left: none; border-top: 1px solid var(--rule); padding: 2rem 0; }
    .wiki-card:first-child { border-top: none; }
    .log-card { grid-template-columns: 50px 1fr; gap: 1rem; padding: 1.5rem 0; }
    .log-num { font-size: 1.8rem; }
    .log-title { font-size: 1.3rem; }
    .hero-scroll { display: none; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>

</BaseLayout>
